  <Routines>
    <Routine name="instruct">
      <RoutineSettingsComponent name="instruct" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="instruct" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="vpixx" plugin="None">
        <Param val="# =====================================================================&amp;#10;# VPixx Pixel Mode B triggers (MEG lab)&amp;#10;# ---------------------------------------------------------------------&amp;#10;# A 1x1 px patch in the upper-left corner carries the trigger value in&amp;#10;# its BLUE channel (red = green = 0). At each vsync the DATAPixx3 reads&amp;#10;# that pixel and puts the value on its digital output -&gt; MEG trigger&amp;#10;# channel. 8 lines available: 1, 2, 4, 8, 16, 32, 64, 128.&amp;#10;#&amp;#10;# Trigger pixel colours are written literally as (R, G, B) in 0-255&amp;#10;# (the patch uses colorSpace='rgb255'). Only blue carries the trigger.&amp;#10;#   TRIG_FIXATION   (0, 0, 1)   fixation cross onset (every trial)&amp;#10;#   TRIG_TARGET_L   (0, 0, 2)   target onset, LEFT&amp;#10;#   TRIG_TARGET_R   (0, 0, 4)   target onset, RIGHT&amp;#10;#   TRIG_RESET      (0, 0, 0)   black = all trigger lines low&amp;#10;#   spare blue values: 8, 16, 32, 64, 128&amp;#10;#&amp;#10;# Each onset trigger is held for TRIG_HOLD_FRAMES video frames and then&amp;#10;# the pixel is reset to black (0). The trigger edge marks the vsync at&amp;#10;# which the display BEGINS scanning out the new frame.&amp;#10;# =====================================================================&amp;#10;import atexit&amp;#10;&amp;#10;TRIG_FIXATION = (0, 0, 1)&amp;#10;TRIG_TARGET_L = (0, 0, 2)&amp;#10;TRIG_TARGET_R = (0, 0, 4)&amp;#10;TRIG_RESET = (0, 0, 0)&amp;#10;TRIG_HOLD_FRAMES = 1   # 1 frame = 8.33 ms at 120 Hz (~10 samples at 1200 Hz)&amp;#10;&amp;#10;# pypixxlib is imported here; if it is missing the experiment falls back&amp;#10;# to dummy mode (no triggers sent, *.vp columns left empty).&amp;#10;try:&amp;#10;    from pypixxlib import _libdpx as _real_dp&amp;#10;    _HAS_PYPIXXLIB = True&amp;#10;except ImportError:&amp;#10;    _real_dp = None&amp;#10;    _HAS_PYPIXXLIB = False&amp;#10;&amp;#10;&amp;#10;class _MockDPx:&amp;#10;    &quot;&quot;&quot;No-op stand-in for pypixxlib._libdpx (dummy mode).&quot;&quot;&quot;&amp;#10;    def __getattr__(self, name):&amp;#10;        if name == 'DPxGetTime':&amp;#10;            return lambda: 0.0&amp;#10;        return lambda *a, **k: None&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# NOTE: Builder runs this tab INSIDE run(), where win, thisExp and expInfo&amp;#10;# live. The VPixx helpers are therefore defined here (not in Before&amp;#10;# Experiment) so they can see dp, win, thisExp and trigger_patch.&amp;#10;&amp;#10;# ---- connect to the DATAPixx3 (or fall back to dummy mode) ----&amp;#10;DUMMY_VPIXX = str(expInfo.get('dummy_vpixx', False)).lower() in ('true', '1', 'yes')&amp;#10;if not _HAS_PYPIXXLIB and not DUMMY_VPIXX:&amp;#10;    logging.warning('pypixxlib not installed: forcing dummy VPixx mode (NO TRIGGERS)')&amp;#10;    DUMMY_VPIXX = True&amp;#10;dp = _MockDPx() if DUMMY_VPIXX else _real_dp&amp;#10;_vpx = {'closed': False, 'frames_left': 0}&amp;#10;&amp;#10;&amp;#10;def init_vpixx():&amp;#10;    dp.DPxOpen()&amp;#10;    dp.DPxStopAllScheds()&amp;#10;    dp.DPxEnableDoutPixelModeB()   # blue-channel trigger output&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;&amp;#10;def close_vpixx():&amp;#10;    # Disable pixel mode and disconnect (safe to call more than once).&amp;#10;    if _vpx['closed']:&amp;#10;        return&amp;#10;    _vpx['closed'] = True&amp;#10;    for fn in ('DPxStopAllScheds', 'DPxDisableDoutPixelMode',&amp;#10;               'DPxWriteRegCache', 'DPxClose'):&amp;#10;        try:&amp;#10;            getattr(dp, fn)()&amp;#10;        except Exception:&amp;#10;            pass&amp;#10;&amp;#10;&amp;#10;def _set_patch(rgb):&amp;#10;    # rgb is an (R, G, B) tuple in 0-255; the patch is in 'rgb255' space&amp;#10;    trigger_patch.fillColor = rgb&amp;#10;    trigger_patch.lineColor = rgb&amp;#10;&amp;#10;&amp;#10;def _stamp_vp(label):&amp;#10;    # Runs right after the flip that showed the trigger: VPixx clock time.&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    dp.DPxUpdateRegCache()&amp;#10;    thisExp.addData(label + '.vp', dp.DPxGetTime())&amp;#10;&amp;#10;&amp;#10;def send_trigger(rgb, label=None):&amp;#10;    # Put the (R, G, B) colour `rgb` on the trigger pixel for the NEXT flip,&amp;#10;    # then auto-reset. Blue = trigger value on the MEG trigger channel.&amp;#10;    # Call from Each Frame on the frame a stimulus starts&amp;#10;    # (frameNStart == frameN) so the trigger shares the stimulus flip.&amp;#10;    _set_patch(rgb)&amp;#10;    _vpx['frames_left'] = TRIG_HOLD_FRAMES&amp;#10;    if label:&amp;#10;        thisExp.addData(label + '.trigger', rgb[2])   # blue = trigger value&amp;#10;        win.callOnFlip(_stamp_vp, label)&amp;#10;&amp;#10;&amp;#10;def tick_trigger():&amp;#10;    # Call FIRST in Each Frame: resets the pixel to black after the hold.&amp;#10;    if _vpx['frames_left'] &gt; 0:&amp;#10;        _vpx['frames_left'] -= 1&amp;#10;        if _vpx['frames_left'] == 0:&amp;#10;            _set_patch(TRIG_RESET)&amp;#10;&amp;#10;&amp;#10;def reset_trigger():&amp;#10;    # Force the pixel to black (call in Begin Routine of every routine).&amp;#10;    _vpx['frames_left'] = 0&amp;#10;    _set_patch(TRIG_RESET)&amp;#10;&amp;#10;&amp;#10;# Pixel Mode reads the top-left pixel of the whole SCREEN. If the window is&amp;#10;# not full screen (e.g. Builder's Pilot mode forces an 800x600 window), that&amp;#10;# pixel belongs to the desktop and the trigger lines show garbage. Refuse to&amp;#10;# run with real hardware unless the window is full screen in Run mode.&amp;#10;if not DUMMY_VPIXX and (PILOTING or not win.fullscr):&amp;#10;    msg = ('VPixx Pixel Mode triggers need a FULL-SCREEN window in RUN mode '&amp;#10;           '(PILOTING=%s, fullscr=%s). Switch Builder from Pilot to Run, or '&amp;#10;           'tick dummy_vpixx to test without triggers.' % (PILOTING, win.fullscr))&amp;#10;    logging.error(msg)&amp;#10;    raise RuntimeError(msg)&amp;#10;&amp;#10;init_vpixx()&amp;#10;atexit.register(close_vpixx)   # also closes the device if the run aborts&amp;#10;thisExp.addData('dummy_vpixx', DUMMY_VPIXX)&amp;#10;&amp;#10;# ---- 1x1 px trigger patch, exact upper-left screen pixel ----&amp;#10;_ww, _wh = win.size&amp;#10;trigger_patch = visual.Rect(&amp;#10;    win, units='pix', width=1, height=1,&amp;#10;    pos=(-_ww / 2.0 + 0.5, _wh / 2.0 - 0.5),&amp;#10;    lineWidth=0, colorSpace='rgb255',&amp;#10;    fillColor=TRIG_RESET, lineColor=TRIG_RESET,&amp;#10;    interpolate=False, autoLog=False)&amp;#10;trigger_patch.setAutoDraw(True)   # drawn on every flip for the whole session&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="reset_trigger()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="tick_trigger()&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="# black trigger pixel, pixel mode off, device closed&amp;#10;reset_trigger()&amp;#10;trigger_patch.setAutoDraw(False)&amp;#10;close_vpixx()&amp;#10;" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="vpixx" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="taskInstructions" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
