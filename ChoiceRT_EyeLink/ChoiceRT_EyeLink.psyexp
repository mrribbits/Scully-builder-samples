      <HostDrawing name="HostDrawing" plugin="psychopy-eyelink">
        <Param val="'draw_box %d %d %d %d 2' % (scn_width/2.0 - targetEccPix - targetSizePix/2.0, scn_height/2.0 - targetSizePix/2.0, scn_width/2.0 - targetEccPix + targetSizePix/2.0, scn_height/2.0 + targetSizePix/2.0); 'draw_box %d %d %d %d 2' % (scn_width/2.0 + targetEccPix - targetSizePix/2.0, scn_height/2.0 - targetSizePix/2.0, scn_width/2.0 + targetEccPix + targetSizePix/2.0, scn_height/2.0 + targetSizePix/2.0)" valType="str" updates="None" name="additionalDrawCommands" />
