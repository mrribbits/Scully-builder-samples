    <Routine name="eyelinkStartRecording">
      <RoutineSettingsComponent name="eyelinkStartRecording" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="eyelinkStartRecording" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <HostDrawing name="HostDrawing" plugin="psychopy-eyelink">
        <Param val="'draw_box %d %d %d %d 2' % (scn_width/2.0 - targetEccPix - targetSizePix/2.0, scn_height/2.0 - targetSizePix/2.0, scn_width/2.0 - targetEccPix + targetSizePix/2.0, scn_height/2.0 + targetSizePix/2.0); 'draw_box %d %d %d %d 2' % (scn_width/2.0 + targetEccPix - targetSizePix/2.0, scn_height/2.0 - targetSizePix/2.0, scn_width/2.0 + targetEccPix + targetSizePix/2.0, scn_height/2.0 + targetSizePix/2.0)" valType="str" updates="None" name="additionalDrawCommands" />
        <Param val="fixation" valType="str" updates="None" name="componentsForDrawingToHostBackdrop" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="" valType="str" updates="None" name="imagesToHostBackdrop" />
        <Param val="HostDrawing" valType="code" updates="None" name="name" />
        <Param val="&quot;Trial %d/%d&quot; % (trials.thisN + 1, trials.nTotal)" valType="str" updates="None" name="recordStatusMessage" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="0.001" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh" />
      </HostDrawing>
      <StartRecording name="StartRecord" plugin="psychopy-eyelink">
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="StartRecord" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="0.001" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh" />
      </StartRecording>
    </Routine>
    <Routine name="trial">
      <RoutineSettingsComponent name="trial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="trial" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="stimSettings" plugin="None">
        <Param val="# ======================================================================&amp;#10;# stimSettings  |  &quot;Before Experiment&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, before the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: works out how big the stimuli should be, and where they&amp;#10;#               go, in PIXELS (the unit this experiment uses), starting&amp;#10;#               from sizes in DEGREES OF VISUAL ANGLE (the unit papers&amp;#10;#               report).&amp;#10;#&amp;#10;# EDIT THE NUMBERS BELOW if the screen, the viewing distance or the&amp;#10;# stimulus sizes change. The fixation, target and Host PC drawing all&amp;#10;# use the pixel values calculated at the bottom.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# &quot;math&quot; is Python's built-in maths library. We need it for tan().&amp;#10;import math&amp;#10;&amp;#10;# ---- The display (MEG lab projector) --------------------------------&amp;#10;screenWidthCm = 60.6        # width of the image on the screen, in cm&amp;#10;screenWidthPix = 1920       # number of pixels across the screen&amp;#10;viewingDistanceCm = 95      # distance from the eyes to the screen, in cm&amp;#10;&amp;#10;# ---- Stimulus sizes, in degrees of visual angle ---------------------&amp;#10;fixationSizeDeg = 0.6       # width and height of the central cross&amp;#10;targetSizeDeg = 1.5         # diameter of the target dot&amp;#10;targetEccDeg = 6.0          # distance of the target from the centre&amp;#10;                            # (the same distance on the left and right)&amp;#10;&amp;#10;# ---- Convert degrees to pixels --------------------------------------&amp;#10;# 1 degree covers 2 * distance * tan(0.5 degrees) centimetres of screen.&amp;#10;# math.radians() converts degrees to radians, which tan() expects.&amp;#10;cmPerDeg = 2 * viewingDistanceCm * math.tan(math.radians(0.5))&amp;#10;&amp;#10;# How many pixels fit in 1 cm of screen.&amp;#10;pixPerCm = screenWidthPix / screenWidthCm&amp;#10;&amp;#10;# How many pixels make up 1 degree (about 52.5 with the numbers above).&amp;#10;pixPerDeg = cmPerDeg * pixPerCm&amp;#10;&amp;#10;# Final sizes in pixels. round() gives a whole number of pixels.&amp;#10;fixationSizePix = round(fixationSizeDeg * pixPerDeg)   # 32 px&amp;#10;targetSizePix = round(targetSizeDeg * pixPerDeg)       # 79 px&amp;#10;targetEccPix = round(targetEccDeg * pixPerDeg)         # 315 px" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="stimSettings" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="trialSetup" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;Begin Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of EVERY trial, before anything is drawn.&amp;#10;#&amp;#10;# WHAT IT DOES: picks a random waiting time (the &quot;foreperiod&quot;) between&amp;#10;#               the fixation cross appearing and the target appearing.&amp;#10;#               Making it random stops the participant from predicting&amp;#10;#               when the target will come.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# random() gives a random number between 0 and 1, so&amp;#10;# 0.8 + random() * 0.7 gives a number between 0.8 and 1.5 (seconds).&amp;#10;foreperiod = 0.8 + random() * 0.7&amp;#10;&amp;#10;# Save the foreperiod as a column called &quot;foreperiod&quot; in PsychoPy's own&amp;#10;# data file.&amp;#10;thisExp.addData('foreperiod', foreperiod)&amp;#10;&amp;#10;# NOTE: the &quot;target&quot; and &quot;resp&quot; components use this value in their Start&amp;#10;# time (&quot;0.2 + foreperiod&quot;). That is why this component sits ABOVE them&amp;#10;# in the routine: it has to run first." valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;End Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of EVERY trial, either after a button press&amp;#10;#               or after 1.5 s with no response.&amp;#10;#&amp;#10;# WHAT IT DOES: 1) works out what happened on this trial;&amp;#10;#               2) writes a summary of it into the eye-tracking data&amp;#10;#                  file (EDF).&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1) What happened on this trial? --------------------------------&amp;#10;# &quot;resp&quot; is the Keyboard component that records the button press.&amp;#10;# If no button was pressed, resp.keys is empty, and &quot;not resp.keys&quot; is&amp;#10;# True.&amp;#10;if not resp.keys:&amp;#10;    timeout = 1          # 1 = no response before the 1.5 s deadline&amp;#10;    respKey = 'NA'       # NA = &quot;not available&quot; (nothing was pressed)&amp;#10;    respRT = 'NA'&amp;#10;    respCorr = 0&amp;#10;else:&amp;#10;    timeout = 0          # 0 = a button was pressed in time&amp;#10;    respKey = resp.keys              # the button pressed: '7' or '2'&amp;#10;    respRT = round(resp.rt, 4)       # reaction time in seconds, timed&amp;#10;                                     # from target onset, to 4 decimals&amp;#10;    respCorr = resp.corr             # 1 = correct button, 0 = wrong one&amp;#10;&amp;#10;# Save the timeout flag as a column in PsychoPy's data file. (The&amp;#10;# Keyboard component saves the key, reaction time and accuracy there by&amp;#10;# itself.)&amp;#10;thisExp.addData('resp.timeout', timeout)&amp;#10;&amp;#10;# ---- 2) Messages for the eye-tracking data file (EDF) ---------------&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;&amp;#10;# One line summarising the trial. In the text below, each %d is replaced&amp;#10;# by a whole number and each %s by text, in the order listed after the&amp;#10;# &quot;%&quot; sign.&amp;#10;#   trials.thisN counts trials from 0, so add 1 to number them from 1.&amp;#10;#   targetSide comes from conditions.csv ('left' or 'right').&amp;#10;el_tracker.sendMessage('TRIAL_SUMMARY trial=%d side=%s key=%s rt=%s corr=%d timeout=%d'&amp;#10;                       % (trials.thisN + 1, targetSide, respKey, respRT, respCorr, timeout))&amp;#10;&amp;#10;# Messages that start with &quot;!V TRIAL_VAR&quot; become trial variables in&amp;#10;# SR Research's Data Viewer program.&amp;#10;el_tracker.sendMessage('!V TRIAL_VAR timeout %d' % timeout)" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="fixation" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="white" valType="color" updates="constant" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="white" valType="color" updates="constant" name="lineColor" />
        <Param val="1" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="fixation" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="cross" valType="str" updates="None" name="shape" />
        <Param val="(fixationSizePix, fixationSizePix)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.2" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
      <PolygonComponent name="target" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="white" valType="color" updates="constant" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="white" valType="color" updates="constant" name="lineColor" />
        <Param val="1" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="target" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(targetX * targetEccPix, 0)" valType="list" updates="set every repeat" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="circle" valType="str" updates="None" name="shape" />
        <Param val="(targetSizePix, targetSizePix)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.2 + foreperiod" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="1.5" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
      <KeyboardComponent name="resp" plugin="None">
        <Param val="&quot;7&quot;,&quot;2&quot;" valType="list" updates="constant" name="allowedKeys" />
        <Param val="$corrAns" valType="str" updates="constant" name="correctAns" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="True" valType="bool" updates="constant" name="discard previous" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine" />
        <Param val="resp" valType="code" updates="None" name="name" />
        <Param val="press" valType="str" updates="constant" name="registerOn" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.2 + foreperiod" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="1.5" valType="code" updates="constant" name="stopVal" />
        <Param val="first key" valType="str" updates="constant" name="store" />
        <Param val="True" valType="bool" updates="constant" name="storeCorrect" />
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh" />
      </KeyboardComponent>
      <CodeComponent name="targetOnsetMsg" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# targetOnsetMsg  |  &quot;Begin Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of every trial.&amp;#10;#&amp;#10;# WHAT IT DOES: notes that the target-onset message has not been sent yet&amp;#10;#               on this trial. (The &quot;Each Frame&quot; tab sends it.)&amp;#10;# ======================================================================&amp;#10;targetMsgSent = False" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="# ======================================================================&amp;#10;# targetOnsetMsg  |  &quot;Each Frame&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: on EVERY screen refresh during the trial (120 times a&amp;#10;#               second on a 120 Hz display).&amp;#10;#&amp;#10;# WHAT IT DOES: writes TARGET_ONSET_LEFT or TARGET_ONSET_RIGHT into the&amp;#10;#               eye-tracking data file at the exact moment the target&amp;#10;#               appears on the screen.&amp;#10;#&amp;#10;# HOW IT WORKS:&amp;#10;#   - When the target's start time arrives, PsychoPy sets target.status&amp;#10;#     to STARTED and draws the target. The target becomes visible at the&amp;#10;#     next screen refresh, which PsychoPy calls a &quot;flip&quot;.&amp;#10;#   - win.callOnFlip(...) asks PsychoPy to run something at that flip,&amp;#10;#     so the message is timed to the moment the target really appears.&amp;#10;#   - This component must sit BELOW the target in the routine, so that&amp;#10;#     target.status has already been updated on the current frame.&amp;#10;#   - targetMsgSent makes sure the message is sent only once per trial.&amp;#10;# ======================================================================&amp;#10;if target.status == STARTED and not targetMsgSent:&amp;#10;    el_tracker = pylink.getEYELINK()&amp;#10;&amp;#10;    # Build the message text. .upper() turns 'left' into 'LEFT'.&amp;#10;    messageText = 'TARGET_ONSET_' + targetSide.upper()&amp;#10;&amp;#10;    # Send the message at the moment of the next screen flip.&amp;#10;    win.callOnFlip(el_tracker.sendMessage, messageText)&amp;#10;&amp;#10;    # Remember that it has been sent, so it isn't sent again this trial.&amp;#10;    targetMsgSent = True" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="targetOnsetMsg" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="trialLog" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# trialLog  |  &quot;Begin Experiment&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experiment starts.&amp;#10;#&amp;#10;# WHAT IT DOES: creates a simple table with ONE ROW PER TRIAL (the&amp;#10;#               &quot;trial log&quot;). Columns are separated by tabs, so it opens&amp;#10;#               in Excel, R, Python, etc. It is saved in this session's&amp;#10;#               folder under &quot;results&quot;, next to the eye-tracking file,&amp;#10;#               and its name ends in &quot;_trials_log.tsv&quot;.&amp;#10;#&amp;#10;# There is no &quot;close the file&quot; step at the end. The EyeLink plugin ends&amp;#10;# the experiment by itself after copying the eye-tracking file, and the&amp;#10;# log is closed automatically then. Each row is saved as soon as it is&amp;#10;# written (see the &quot;End Routine&quot; tab), so nothing is lost.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# thisExp.dataFileName is where PsychoPy saves its own data files,&amp;#10;# without the file extension. Add our own ending to it.&amp;#10;logFileName = thisExp.dataFileName + '_trials_log.tsv'&amp;#10;&amp;#10;# The column names, in order. Each row written later (in the&amp;#10;# &quot;End Routine&quot; tab) must list its values in this same order.&amp;#10;logColumns = ['participant', 'session', 'date', 'edf_file', 'trial',&amp;#10;              'eyelink_trialid', 'target_side', 'target_x_pix', 'corr_ans',&amp;#10;              'foreperiod_s', 'fixation_onset_s', 'target_onset_s',&amp;#10;              'resp_key', 'rt_s', 'correct', 'timeout']&amp;#10;&amp;#10;# Open the file for writing ('w'), then write the row of column names.&amp;#10;# '\t'.join(...) puts a tab between the names; '\n' ends the line.&amp;#10;logFile = open(logFileName, 'w')&amp;#10;logFile.write('\t'.join(logColumns) + '\n')" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialLog  |  &quot;End Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of every trial.&amp;#10;#&amp;#10;# WHAT IT DOES: adds one row for this trial to the trial log.&amp;#10;#&amp;#10;# This component sits BELOW trialSetup, so respKey, respRT, respCorr and&amp;#10;# timeout have already been worked out there.&amp;#10;#&amp;#10;# WHERE EACH VALUE COMES FROM:&amp;#10;#   expInfo            - the dialog box shown when the experiment starts&amp;#10;#                        (participant number, session)&amp;#10;#   session_identifier - the eye-tracking file name plus the start&amp;#10;#                        time; made by the EyeLink Initialize component&amp;#10;#   trial_index        - the trial number (TRIALID) that the EyeLink&amp;#10;#                        plugin wrote into the eye-tracking file; use it&amp;#10;#                        to match each row to a trial in the EDF&amp;#10;#   targetSide, targetX, corrAns - this trial's row of conditions.csv&amp;#10;#   fixation.tStartRefresh, target.tStartRefresh - when the cross and&amp;#10;#                        the target appeared on screen, in seconds on&amp;#10;#                        PsychoPy's clock (which starts at 0 when the&amp;#10;#                        experiment starts)&amp;#10;# ======================================================================&amp;#10;&amp;#10;# The values for this row, in the same order as logColumns.&amp;#10;rowValues = [&amp;#10;    expInfo['participant'],&amp;#10;    expInfo['session'],&amp;#10;    expInfo['date'],&amp;#10;    session_identifier + '.EDF',          # the eye-tracking file&amp;#10;    trials.thisN + 1,                     # trial number, counting from 1&amp;#10;    trial_index,                          # TRIALID in the EDF&amp;#10;    targetSide,                           # 'left' or 'right'&amp;#10;    targetX * targetEccPix,               # -315 = left, 315 = right&amp;#10;    corrAns,                              # the correct button&amp;#10;    round(foreperiod, 4),                 # waiting time before target (s)&amp;#10;    round(fixation.tStartRefresh, 4),     # when the cross appeared (s)&amp;#10;    round(target.tStartRefresh, 4),       # when the target appeared (s)&amp;#10;    respKey,                              # button pressed, or NA&amp;#10;    respRT,                               # reaction time (s), or NA&amp;#10;    respCorr,                             # 1 = correct, 0 = wrong or none&amp;#10;    timeout,                              # 1 = no response in time&amp;#10;]&amp;#10;&amp;#10;# Turn every value into text, put tabs between them, and write the row.&amp;#10;logFile.write('\t'.join(str(value) for value in rowValues) + '\n')&amp;#10;&amp;#10;# flush() saves the row to disk straight away, so the log is complete&amp;#10;# even if the experiment is stopped early with Ctrl-C.&amp;#10;logFile.flush()" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialLog" valType="code" updates="None" name="name" />
      </CodeComponent>
      <MarkEvents name="MarkEvents" plugin="psychopy-eyelink">
        <Param val="" valType="str" updates="None" name="componentsForEyeLinkInterestAreaMessages" />
        <Param val="resp" valType="str" updates="None" name="componentsForEyeLinkRespEventMessages" />
        <Param val="" valType="str" updates="None" name="componentsForEyeLinkStimDVDrawingMessages" />
        <Param val="fixation,target" valType="str" updates="None" name="componentsForEyeLinkStimEventMessages" />
        <Param val="" valType="str" updates="None" name="componentsForEyeLinkTargetPositionMessages" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="True" valType="bool" updates="None" name="includeAllEventMarkedComponentsForDVDrawingMessages" />
        <Param val="True" valType="bool" updates="None" name="includeAllEventMarkedComponentsForIAMessages" />
        <Param val="20" valType="str" updates="None" name="interestAreaMargins" />
        <Param val="Ellipse" valType="str" updates="constant" name="interestAreaShape" />
        <Param val="MarkEvents" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="False" valType="bool" updates="None" name="sendTrialOnsetOffsetMessages" />
        <Param val="False" valType="bool" updates="None" name="sendVideoFrameMessages" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="0.001" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="targetSide,targetX,corrAns,foreperiod" valType="str" updates="None" name="trialConditionVariablesForEyeLinkLogging" />
        <Param val="True" valType="bool" updates="None" name="useQuitKeys" />
      </MarkEvents>
    </Routine>
    <Routine name="eyelinkStopRecording">
      <RoutineSettingsComponent name="eyelinkStopRecording" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="eyelinkStopRecording" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <StopRecording name="StopRecord" plugin="psychopy-eyelink">
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="StopRecord" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="0.001" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh" />
      </StopRecording>
    </Routine>
    <Routine name="thanks">
      <RoutineSettingsComponent name="thanks" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="thanks" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="taskEndMsg" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# taskEndMsg  |  &quot;Begin Routine&quot; tab  |  routine: thanks&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the final &quot;thank you&quot; screen appears.&amp;#10;#&amp;#10;# WHAT IT DOES: writes TASK_END into the eye-tracking data file (EDF) to&amp;#10;#               mark the end of the task.&amp;#10;# ======================================================================&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;el_tracker.sendMessage('TASK_END')" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="taskEndMsg" valType="code" updates="None" name="name" />
      </CodeComponent>
      <TextComponent name="endScreen" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="num" updates="None" name="durationEstim" />
        <Param val="None" valType="str" updates="constant" name="flip" />
        <Param val="Open Sans" valType="str" updates="constant" name="font" />
        <Param val="LTR" valType="str" updates="None" name="languageStyle" />
        <Param val="36" valType="num" updates="constant" name="letterHeight" />
        <Param val="endScreen" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="num" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0" valType="num" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="3" valType="num" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="All done - thank you!&#10;&#10;Please stay still while we save the data." valType="str" updates="constant" name="text" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="1500" valType="num" updates="constant" name="wrapWidth" />
      </TextComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="eyelinkSetup" />
    <Routine name="instruct" />
    <Routine name="eyelinkDriftCheck" />
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="[OrderedDict([('targetSide', 'left'), ('targetX', -1), ('corrAns', '7')]), OrderedDict([('targetSide', 'right'), ('targetX', 1), ('corrAns', '2')])]" valType="str" />
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="str" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num" />
      <Param name="isTrials" updates="None" val="True" valType="bool" />
      <Param name="loopType" updates="None" val="random" valType="str" />
      <Param name="nReps" updates="None" val="20" valType="num" />
      <Param name="name" updates="None" val="trials" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
    <Routine name="eyelinkStartRecording" />
    <Routine name="trial" />
    <Routine name="eyelinkStopRecording" />
    <LoopTerminator name="trials" />
    <Routine name="thanks" />
  </Flow>
</PsychoPy2experiment>
