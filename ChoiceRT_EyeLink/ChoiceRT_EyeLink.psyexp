        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# --- EyeLink 1000 Plus, Remote Mode, 500 Hz (MEG lab) ---&amp;#10;# The Initialize component (below) has already connected to the Host PC.&amp;#10;# Remote mode itself (camera mount / &quot;Desktop - Remote&quot; configuration and the&amp;#10;# forehead target sticker) is selected on the Host PC Set Options screen.&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;if not dummy_mode:&amp;#10;    el_tracker.setOfflineMode()&amp;#10;    # sampling rate: Remote mode on the 1000 Plus runs at up to 500 Hz&amp;#10;    el_tracker.sendCommand(&quot;sample_rate 500&quot;)&amp;#10;    # Uncomment to force the camera configuration from the script instead of&amp;#10;    # the Host PC (RTABLER = desktop mount, remote, monocular)&amp;#10;    # el_tracker.sendCommand(&quot;elcl_select_configuration = RTABLER&quot;)&amp;#10;    el_tracker.sendMessage(&quot;SESSION_CONFIG remote_mode sample_rate_500&quot;)" valType="extendedCode" updates="constant" name="Begin Routine" />
