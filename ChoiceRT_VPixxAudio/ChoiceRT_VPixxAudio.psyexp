        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="vpixxAudioSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# vpixxAudioSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, before the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: sets the tone parameters, makes the tone, and loads the&amp;#10;#               VPixx library.&amp;#10;#&amp;#10;# HOW THE SOUND IS PLAYED (read this first):&amp;#10;#   The tone is not played by the stimulus PC's sound card. It is played&amp;#10;#   by the DATAPixx3, VPixx's box that sits between the PC and the&amp;#10;#   display. The DATAPixx3 has its own memory and its own audio output.&amp;#10;#     1. At the start of the experiment we copy the tone, once, into the&amp;#10;#        DATAPixx3's memory.&amp;#10;#     2. Each trial we give the DATAPixx3 an &quot;audio schedule&quot;: play that&amp;#10;#        tone, at 48000 samples per second, into the LEFT (or RIGHT) ear.&amp;#10;#     3. On the frame the tone should start, we tell it &quot;start&quot;, timed&amp;#10;#        to arrive exactly when the screen refreshes. That way we know&amp;#10;#        the tone started at that screen refresh, to well under 1 ms.&amp;#10;#   The stimulus PC's own audio is far less precise (often 20-60 ms of&amp;#10;#   unpredictable delay), which is why we use the DATAPixx3 instead.&amp;#10;#&amp;#10;# This experiment uses NO MEG triggers, NO Pixel Mode and NO eye&amp;#10;# tracking. Tone times are saved to the data file only.&amp;#10;#&amp;#10;# EDIT THE NUMBERS BELOW to change the tone.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# &quot;numpy&quot; is a maths library for working with long lists of numbers.&amp;#10;# Builder loads it already, but importing it here makes it clear where&amp;#10;# &quot;np&quot; comes from.&amp;#10;import numpy as np&amp;#10;&amp;#10;# &quot;atexit&quot; is part of Python. It lets us name a function that must run&amp;#10;# when the program closes, however it closes (see Begin Experiment).&amp;#10;import atexit&amp;#10;&amp;#10;# ---- The tone --------------------------------------------------------&amp;#10;toneFreqHz = 1000          # pitch of the tone, in Hz (cycles per second)&amp;#10;toneDurationSec = 0.100    # how long the tone lasts: 100 ms&amp;#10;rampSec = 0.010            # 10 ms fade-in and fade-out (avoids clicks)&amp;#10;sampleRate = 48000         # numbers per second the DATAPixx3 plays&amp;#10;toneLoudness = 0.8         # 0 to 1: how much of the full range to use&amp;#10;audioVolume = 0.5          # 0 to 1: DATAPixx3 output volume, both ears&amp;#10;&amp;#10;# Where in the DATAPixx3's memory the tone is stored. 16,000,000 is the&amp;#10;# address VPixx uses by default for audio. Leave it as it is.&amp;#10;toneMemoryAddress = 16000000&amp;#10;&amp;#10;# ---- Make the tone ---------------------------------------------------&amp;#10;# A sound is just a long list of numbers: the position of the&amp;#10;# loudspeaker at each moment. For a pure tone those numbers follow a&amp;#10;# sine wave.&amp;#10;&amp;#10;# How many numbers (samples) the tone needs: 0.1 s x 48000 = 4800.&amp;#10;nSamples = int(round(toneDurationSec * sampleRate))&amp;#10;&amp;#10;# The time of each sample in seconds: 0, 1/48000, 2/48000, ...&amp;#10;# np.arange(n) makes the list 0, 1, 2, ... n-1.&amp;#10;sampleTimes = np.arange(nSamples) / sampleRate&amp;#10;&amp;#10;# The sine wave itself, with values from -1 to +1.&amp;#10;tone = np.sin(2 * np.pi * toneFreqHz * sampleTimes)&amp;#10;&amp;#10;# Fade-in and fade-out. Without them, the sudden start and stop of the&amp;#10;# wave is heard as a click. &quot;fade&quot; rises smoothly from 0 to 1.&amp;#10;nRampSamples = int(round(rampSec * sampleRate))           # 480 samples&amp;#10;fade = 0.5 * (1 - np.cos(np.pi * np.arange(nRampSamples) / nRampSamples))&amp;#10;tone[:nRampSamples] = tone[:nRampSamples] * fade          # first 10 ms&amp;#10;tone[-nRampSamples:] = tone[-nRampSamples:] * fade[::-1]  # last 10 ms&amp;#10;# ([:n] means &quot;the first n values&quot;, [-n:] means &quot;the last n values&quot; and&amp;#10;#  [::-1] means &quot;in reverse order&quot;, so the end fades out.)&amp;#10;&amp;#10;# The DATAPixx3 wants whole numbers from -32767 to +32767 (16-bit audio,&amp;#10;# &quot;int16&quot;), so scale the wave and convert it.&amp;#10;toneWave = (tone * toneLoudness * 32767).astype(np.int16)&amp;#10;&amp;#10;# ---- Load the VPixx library -----------------------------------------&amp;#10;# &quot;pypixxlib&quot; is VPixx's Python library for talking to the DATAPixx3.&amp;#10;# try/except ImportError means: try to load it, and if it isn't&amp;#10;# installed on this computer, carry on without it instead of crashing.&amp;#10;# Begin Experiment then switches to dummy mode (no DATAPixx3).&amp;#10;try:&amp;#10;    from pypixxlib import _libdpx as dp&amp;#10;    pypixxlibInstalled = True&amp;#10;except ImportError:&amp;#10;    dp = None&amp;#10;    pypixxlibInstalled = False&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# ======================================================================&amp;#10;# vpixxAudioSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the start dialog and after the window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: connects to the DATAPixx3, turns its audio on, copies the&amp;#10;#               tone into its memory, and makes sure the connection is&amp;#10;#               closed when the experiment ends. In dummy mode (no&amp;#10;#               DATAPixx3) it prepares ordinary PsychoPy sounds instead.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   expInfo  - Builder: the answers typed into the start dialog.&amp;#10;#   thisExp  - Builder: the data file. thisExp.addData(name, value)&amp;#10;#              adds a column to the current row.&amp;#10;#   logging  - PsychoPy: writes messages to the console and the log.&amp;#10;#   win      - Builder: the experiment window.&amp;#10;#   dp, pypixxlibInstalled, toneWave and the tone settings - the&amp;#10;#              Before Experiment tab above.&amp;#10;#&amp;#10;# WHY THIS IS IN &quot;Begin Experiment&quot; AND NOT &quot;Before Experiment&quot;:&amp;#10;#   It needs expInfo (to know whether dummy mode was ticked) and win.&amp;#10;#   Builder only creates those inside its main function, run(), and&amp;#10;#   only the Begin Experiment tab is placed inside run().&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- Dummy mode? -----------------------------------------------------&amp;#10;# The &quot;dummy_vpixx&quot; tick box in the start dialog runs the experiment&amp;#10;# without a DATAPixx3, for testing on any computer. bool() turns the&amp;#10;# tick box answer into True or False.&amp;#10;DUMMY_VPIXX = bool(expInfo['dummy_vpixx'])&amp;#10;&amp;#10;# Without pypixxlib we can't talk to a DATAPixx3, so force dummy mode.&amp;#10;if not pypixxlibInstalled and not DUMMY_VPIXX:&amp;#10;    logging.warning('pypixxlib is not installed, so dummy_vpixx was turned '&amp;#10;                    'on: tones play through PsychoPy and are NOT precisely timed')&amp;#10;    DUMMY_VPIXX = True&amp;#10;&amp;#10;# Record the mode in the data file, so a dummy run can't be mistaken&amp;#10;# for a real one later.&amp;#10;thisExp.addData('dummy_vpixx', DUMMY_VPIXX)&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    # ---- Real DATAPixx3 ----------------------------------------------&amp;#10;    # How VPixx commands work: most dp.DPx... commands only change a&amp;#10;    # local copy of the DATAPixx3's settings (the &quot;register cache&quot;) on&amp;#10;    # the stimulus PC. Nothing reaches the device until we send that&amp;#10;    # copy with dp.DPxWriteRegCache().&amp;#10;    dp.DPxOpen()                       # connect over USB&amp;#10;    dp.DPxStopAllScheds()              # stop anything left playing&amp;#10;    dp.DPxInitAudCodec()               # switch the audio output on&amp;#10;    # The volume starts at 0 (silent!) every time the device is opened,&amp;#10;    # so it must be set here, or every tone plays silently with no error.&amp;#10;    dp.DPxSetAudLeftVolume(audioVolume)&amp;#10;    dp.DPxSetAudRightVolume(audioVolume)&amp;#10;    dp.DPxWriteRegCache()              # send the settings above&amp;#10;&amp;#10;    # Copy the tone into the DATAPixx3's memory. This is done once; each&amp;#10;    # trial just replays it.&amp;#10;    dp.DPxWriteAudioBuffer(toneWave, toneMemoryAddress)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;    logging.exp('DATAPixx3 audio ready: %d samples = %.1f ms'&amp;#10;                % (len(toneWave), 1000 * len(toneWave) / sampleRate))&amp;#10;    # (%d puts a whole number into the text and %.1f a number with one&amp;#10;    #  decimal place, in the order listed after the %.)&amp;#10;&amp;#10;    # ---- Close the connection when the experiment ends ------------------&amp;#10;    def closeVpixx():&amp;#10;        # Stop playback and disconnect from the DATAPixx3.&amp;#10;        dp.DPxStopAllScheds()&amp;#10;        dp.DPxWriteRegCache()&amp;#10;        dp.DPxClose()&amp;#10;&amp;#10;    # atexit.register() means: run closeVpixx when the program ends.&amp;#10;    # It runs whether the experiment finishes normally or you press Esc.&amp;#10;    # (There is deliberately no &quot;End Experiment&quot; code: Builder skips the&amp;#10;    #  End Experiment tab when you press Esc, so cleanup there would not&amp;#10;    #  always run.)&amp;#10;    atexit.register(closeVpixx)&amp;#10;&amp;#10;else:&amp;#10;    # ---- Dummy mode ---------------------------------------------------&amp;#10;    # Make two stereo PsychoPy sounds from the same tone: one with the&amp;#10;    # tone in the left channel and silence in the right, and one the&amp;#10;    # other way round. They play in the correct ear, but their timing&amp;#10;    # is NOT precise, so use dummy mode for testing only.&amp;#10;    # (&quot;sound&quot; is PsychoPy's sound module. Builder loads it at the top&amp;#10;    #  of the script, so it isn't imported again here.)&amp;#10;    toneFloat = toneWave / 32767.0        # PsychoPy wants -1 to +1&amp;#10;    silence = np.zeros(len(toneFloat))    # a list of zeros, same length&amp;#10;    # np.column_stack([a, b]) puts two lists side by side as two&amp;#10;    # columns: column 1 = left ear, column 2 = right ear.&amp;#10;    dummySounds = {&amp;#10;        'left':  sound.Sound(np.column_stack([toneFloat, silence]),&amp;#10;                             sampleRate=sampleRate, stereo=True),&amp;#10;        'right': sound.Sound(np.column_stack([silence, toneFloat]),&amp;#10;                             sampleRate=sampleRate, stereo=True),&amp;#10;    }&amp;#10;    # (A &quot;dict&quot;, written {key: value, ...}, looks values up by name:&amp;#10;    #  dummySounds['left'] is the left-ear sound.)&amp;#10;&amp;#10;&amp;#10;# ---- Save the DATAPixx3 clock at the tone's start ----------------------&amp;#10;# def creates a function: a named block of code we can run later.&amp;#10;# This one is not run now. toneStart (trial routine) hands it to&amp;#10;# win.callOnFlip(), which runs it straight after the screen refresh at&amp;#10;# which the tone starts.&amp;#10;def saveToneTime():&amp;#10;    if not DUMMY_VPIXX:&amp;#10;        dp.DPxUpdateRegCache()   # fetch the device's current state...&amp;#10;        thisExp.addData('tone.vp', dp.DPxGetTime())   # ...and its clock&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="vpixxAudioSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="taskInstructions" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="32" valType="num" updates="constant" name="letterHeight"/>
        <Param val="taskInstructions" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="On each trial you will hear a short tone in your LEFT or RIGHT ear.&amp;#10;&amp;#10;Tone in the LEFT ear: press with your LEFT index finger.&amp;#10;Tone in the RIGHT ear: press with your RIGHT index finger.&amp;#10;&amp;#10;Respond as quickly and accurately as you can, and keep your eyes on the cross.&amp;#10;&amp;#10;Press either button to start." valType="str" updates="constant" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1400" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="ready" plugin="None">
        <Param val="'7', '2'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="ready" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="last key" valType="str" updates="constant" name="store"/>
        <Param val="False" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="trial">
      <RoutineSettingsComponent name="trial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trial" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="stimSettings" plugin="None">
        <Param val="# ======================================================================&amp;#10;# stimSettings  |  &quot;Before Experiment&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, before the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: works out how big the fixation cross should be in PIXELS&amp;#10;#               (the unit this experiment uses), starting from its size&amp;#10;#               in DEGREES OF VISUAL ANGLE (the unit papers report).&amp;#10;#               Same numbers as the two visual versions of this task.&amp;#10;#&amp;#10;# EDIT THE NUMBERS BELOW if the screen, the viewing distance or the&amp;#10;# cross size change.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# &quot;math&quot; is Python's built-in maths library. We need it for tan().&amp;#10;import math&amp;#10;&amp;#10;# ---- The display (MEG lab projector) --------------------------------&amp;#10;screenWidthCm = 60.6        # width of the image on the screen, in cm&amp;#10;screenWidthPix = 1920       # number of pixels across the screen&amp;#10;viewingDistanceCm = 95      # distance from the eyes to the screen, in cm&amp;#10;&amp;#10;# ---- Stimulus size, in degrees of visual angle ----------------------&amp;#10;fixationSizeDeg = 0.6       # width and height of the central cross&amp;#10;&amp;#10;# ---- Convert degrees to pixels --------------------------------------&amp;#10;# 1 degree covers 2 * distance * tan(0.5 degrees) centimetres of screen.&amp;#10;# math.radians() converts degrees to radians, which tan() expects.&amp;#10;cmPerDeg = 2 * viewingDistanceCm * math.tan(math.radians(0.5))&amp;#10;&amp;#10;# How many pixels fit in 1 cm of screen.&amp;#10;pixPerCm = screenWidthPix / screenWidthCm&amp;#10;&amp;#10;# How many pixels make up 1 degree (about 52.5 with the numbers above).&amp;#10;pixPerDeg = cmPerDeg * pixPerCm&amp;#10;&amp;#10;# Final size in pixels. round() gives a whole number of pixels.&amp;#10;# The fixation component's Size field is (fixationSizePix, fixationSizePix).&amp;#10;fixationSizePix = round(fixationSizeDeg * pixPerDeg)    # 32 px&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="stimSettings" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="trialSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;Before Experiment&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, before the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: sets the trial timing, in seconds.&amp;#10;#&amp;#10;# A trial: fixation cross on -&gt; wait ITI + foreperiod -&gt; tone -&gt; up to&amp;#10;# responseWindow seconds to answer. The cross stays on the whole time.&amp;#10;# ======================================================================&amp;#10;&amp;#10;ITI = 0.5                  # fixed part of the wait before the tone&amp;#10;foreperiodMin = 0.8        # plus a random extra wait between these two&amp;#10;foreperiodMax = 1.5        #   values, so the tone can't be predicted&amp;#10;responseWindow = 1.5       # time allowed to answer, from tone onset&amp;#10;&amp;#10;# (The wait is split into ITI + foreperiod only so the timing and the&amp;#10;#  &quot;foreperiod&quot; data column match the two visual versions of this task,&amp;#10;#  where the ITI was a blank screen.)&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;Begin Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of every trial, before anything is drawn.&amp;#10;#&amp;#10;# WHAT IT DOES: picks this trial's random wait, works out when the tone&amp;#10;#               starts, and gives the DATAPixx3 this trial's audio&amp;#10;#               schedule (which ear) without starting it yet.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   toneSide - conditions.csv: 'left' or 'right' for this trial. The&amp;#10;#              trials loop sets one value per trial, in random order.&amp;#10;#   np       - numpy (vpixxAudioSetup).&amp;#10;#   DUMMY_VPIXX, dp, sampleRate, toneWave, toneMemoryAddress&amp;#10;#            - vpixxAudioSetup.&amp;#10;#&amp;#10;# WHY IT SITS ABOVE THE fixation AND resp COMPONENTS:&amp;#10;#   fixation's duration and resp's start time use toneOnset, so&amp;#10;#   toneOnset must be set first. Builder runs components top to bottom.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# A random number between foreperiodMin and foreperiodMax.&amp;#10;foreperiod = np.random.uniform(foreperiodMin, foreperiodMax)&amp;#10;thisExp.addData('foreperiod', foreperiod)&amp;#10;&amp;#10;# When the tone starts, in seconds from the start of the trial. The&amp;#10;# resp component starts listening at this time too, so its reaction&amp;#10;# time (resp.rt) is measured from the tone.&amp;#10;toneOnset = ITI + foreperiod&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    # The audio schedule: start at once when told (0.0), play at&amp;#10;    # sampleRate, play all the tone's samples, send them to toneSide&amp;#10;    # ('left' or 'right' ear only) and read them from toneMemoryAddress.&amp;#10;    dp.DPxSetAudioSchedule(0.0, sampleRate, len(toneWave), toneSide,&amp;#10;                           toneMemoryAddress)&amp;#10;    dp.DPxWriteRegCache()   # send it to the DATAPixx3 (not started yet)&amp;#10;&amp;#10;# toneStart (below) sets this to True once it has started the tone, so&amp;#10;# the tone is only started once per trial.&amp;#10;toneStarted = False&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;End Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of every trial.&amp;#10;#&amp;#10;# WHAT IT DOES: marks trials with no answer.&amp;#10;#&amp;#10;# resp.keys is the key that was pressed. If nothing was pressed it is&amp;#10;# empty, and &quot;not resp.keys&quot; is True.&amp;#10;# ======================================================================&amp;#10;&amp;#10;if not resp.keys:&amp;#10;    thisExp.addData('timeout', 1)   # no answer in time&amp;#10;else:&amp;#10;    thisExp.addData('timeout', 0)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trialSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <PolygonComponent name="fixation" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="white" valType="color" updates="constant" name="lineColor"/>
        <Param val="1" valType="num" updates="constant" name="lineWidth"/>
        <Param val="4" valType="int" updates="constant" name="nVertices"/>
        <Param val="fixation" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="cross" valType="str" updates="None" name="shape"/>
        <Param val="(fixationSizePix, fixationSizePix)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="toneOnset + responseWindow" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
      <KeyboardComponent name="resp" plugin="None">
        <Param val="'7', '2'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="$corrAns" valType="str" updates="constant" name="correctAns"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="resp" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="toneOnset" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="responseWindow" valType="code" updates="constant" name="stopVal"/>
        <Param val="first key" valType="str" updates="constant" name="store"/>
        <Param val="True" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="toneStart" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# ======================================================================&amp;#10;# toneStart  |  &quot;Each Frame&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: on every screen refresh (&quot;frame&quot;, 120 per second),&amp;#10;#               just before the new frame is shown.&amp;#10;#&amp;#10;# WHAT IT DOES: on the frame the tone is due, tells the DATAPixx3 to&amp;#10;#               start the tone at the moment that frame appears.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   tThisFlip       - Builder: the time (from the start of the trial)&amp;#10;#                     at which the coming frame will appear.&amp;#10;#   tThisFlipGlobal - Builder: the same moment on PsychoPy's main clock.&amp;#10;#   frameTolerance  - Builder: a tiny margin (0.001 s), so a frame due&amp;#10;#                     at exactly toneOnset isn't missed by rounding.&amp;#10;#   toneOnset, toneStarted, toneSide - trialSetup.&amp;#10;#   saveToneTime, dummySounds, DUMMY_VPIXX, dp - vpixxAudioSetup.&amp;#10;#&amp;#10;# WHERE IT SITS: below resp. Its position doesn't change the timing:&amp;#10;#   everything in Each Frame runs before the frame is shown. The test&amp;#10;#   below is the same one Builder uses to start resp, so the tone and&amp;#10;#   resp's reaction-time clock start on the same frame.&amp;#10;# ======================================================================&amp;#10;&amp;#10;if not toneStarted and tThisFlip &gt;= toneOnset - frameTolerance:&amp;#10;&amp;#10;    if not DUMMY_VPIXX:&amp;#10;        # Mark the schedule &quot;start&quot; in the local copy of the settings...&amp;#10;        dp.DPxStartAudSched()&amp;#10;        # ...and send it to the DATAPixx3, which holds it until the next&amp;#10;        # screen refresh, the one Builder is about to show. The tone&amp;#10;        # starts exactly then.&amp;#10;        dp.DPxWriteRegCacheAfterVideoSync()&amp;#10;        # IMPORTANT: between these two lines and the screen refresh,&amp;#10;        # nothing may call dp.DPxUpdateRegCache(). It would replace the&amp;#10;        # local copy with the device's state and erase the &quot;start&quot;.&amp;#10;    else:&amp;#10;        # Dummy mode: play the PsychoPy sound when the frame is shown.&amp;#10;        # win.callOnFlip(f) means &quot;run f straight after the next frame&amp;#10;        # appears&quot;. Note &quot;play&quot; without (): we hand over the function&amp;#10;        # so it can be run later, instead of running it now.&amp;#10;        dummySounds[toneSide].stop()          # in case it's still playing&amp;#10;        win.callOnFlip(dummySounds[toneSide].play)&amp;#10;&amp;#10;    # After the frame appears, save the DATAPixx3's clock (tone.vp).&amp;#10;    win.callOnFlip(saveToneTime)&amp;#10;&amp;#10;    # Save the tone's start time on PsychoPy's clock (tone.started).&amp;#10;    thisExp.addData('tone.started', tThisFlipGlobal)&amp;#10;&amp;#10;    toneStarted = True   # don't start it again this trial&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="toneStart" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="thanks">
      <RoutineSettingsComponent name="thanks" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="thanks" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <TextComponent name="thanksText" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="32" valType="num" updates="constant" name="letterHeight"/>
        <Param val="thanksText" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="3.0" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Thank you!&amp;#10;&amp;#10;The task is complete." valType="str" updates="constant" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1400" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="instruct"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="code"/>
      <Param name="conditions" updates="None" val="[OrderedDict({'toneSide': 'left', 'corrAns': np.int64(7)}), OrderedDict({'toneSide': 'right', 'corrAns': np.int64(2)})]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="20" valType="code"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="trials"/>
    <Routine name="thanks"/>
  </Flow>
</PsychoPy2experiment>
