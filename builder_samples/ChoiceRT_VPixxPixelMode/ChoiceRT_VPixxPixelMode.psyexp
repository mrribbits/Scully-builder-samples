<?xml version="1.0" ?>
<PsychoPy2experiment encoding="utf-8" version="2026.2.3">
  <Settings>
    <Param val="use prefs" valType="str" updates="None" name="Audio lib"/>
    <Param val="" valType="str" updates="None" name="Completed URL"/>
    <Param val="auto" valType="str" updates="None" name="Data file delimiter"/>
    <Param val="u'data/%s_%s_%s' % (expInfo['participant'], expInfo['session'], expInfo['date'])" valType="code" updates="None" name="Data filename"/>
    <Param val="True" valType="bool" updates="None" name="Enable Escape"/>
    <Param val="Thank you for your patience." valType="str" updates="None" name="End Message"/>
    <Param val="{'participant': '', 'session': '001', 'dummy_vpixx': 'False'}" valType="code" updates="None" name="Experiment info"/>
    <Param val="True" valType="bool" updates="None" name="Force stereo"/>
    <Param val="True" valType="bool" updates="None" name="Full-screen window"/>
    <Param val="" valType="str" updates="None" name="HTML path"/>
    <Param val="" valType="str" updates="None" name="Incomplete URL"/>
    <Param val="testMonitor" valType="str" updates="None" name="Monitor"/>
    <Param val="[]" valType="list" updates="None" name="Resources"/>
    <Param val="False" valType="bool" updates="None" name="Save csv file"/>
    <Param val="False" valType="bool" updates="None" name="Save excel file"/>
    <Param val="False" valType="bool" updates="None" name="Save hdf5 file"/>
    <Param val="True" valType="bool" updates="None" name="Save log file"/>
    <Param val="True" valType="bool" updates="None" name="Save psydat file"/>
    <Param val="True" valType="bool" updates="None" name="Save wide csv file"/>
    <Param val="1" valType="num" updates="None" name="Screen"/>
    <Param val="True" valType="bool" updates="None" name="Show info dlg"/>
    <Param val="False" valType="bool" updates="None" name="Show mouse"/>
    <Param val="pix" valType="str" updates="None" name="Units"/>
    <Param val="" valType="str" updates="None" name="Use version"/>
    <Param val="[1920, 1080]" valType="list" updates="None" name="Window size (pixels)"/>
    <Param val="none" valType="str" updates="None" name="backgroundFit"/>
    <Param val="" valType="str" updates="None" name="backgroundImg"/>
    <Param val="avg" valType="str" updates="None" name="blendMode"/>
    <Param val="float" valType="str" updates="None" name="clockFormat"/>
    <Param val="{'thisRow.t': 'priority.CRITICAL', 'expName': 'priority.LOW'}" valType="dict" updates="None" name="colPriority"/>
    <Param val="[-1, -1, -1]" valType="color" updates="None" name="color"/>
    <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
    <Param val="warning" valType="code" updates="None" name="consoleLoggingLevel"/>
    <Param val="ChoiceRT_VPixxPixelMode" valType="str" updates="None" name="expName"/>
    <Param val="" valType="str" updates="None" name="expVersion"/>
    <Param val="on Sync" valType="str" updates="None" name="exportHTML"/>
    <Param val="None" valType="str" updates="None" name="eyetracker"/>
    <Param val="" valType="code" updates="None" name="frameRate"/>
    <Param val="Attempting to measure frame rate of screen, please wait..." valType="str" updates="None" name="frameRateMsg"/>
    <Param val="PsychToolbox" valType="str" updates="None" name="keyboardBackend"/>
    <Param val="info" valType="code" updates="None" name="logging level"/>
    <Param val="True" valType="bool" updates="None" name="measureFrameRate"/>
    <Param val="MIDDLE_BUTTON" valType="list" updates="None" name="mgBlink"/>
    <Param val="CONTINUOUS" valType="str" updates="None" name="mgMove"/>
    <Param val="0.5" valType="num" updates="None" name="mgSaccade"/>
    <Param val="0" valType="code" updates="None" name="runMode"/>
    <Param val="False" valType="bool" updates="None" name="rush"/>
    <Param val="time" valType="str" updates="None" name="sortColumns"/>
    <Param val="pyglet" valType="str" updates="None" name="winBackend"/>
  </Settings>
  <Routines>
    <Routine name="instruct">
      <RoutineSettingsComponent name="instruct" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="instruct" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="vpixxSetup" plugin="None">
        <Param val="# =====================================================================&amp;#10;# vpixxSetup  -  &quot;Before Experiment&quot; tab&amp;#10;# =====================================================================&amp;#10;# WHEN THIS RUNS: once, as soon as the experiment starts, before the&amp;#10;#   participant dialog box appears and before the window opens.&amp;#10;# WHAT IT DOES: (1) defines the trigger colours, (2) loads VPixx's&amp;#10;#   Python library, pypixxlib.&amp;#10;# WHERE IT IS: in the instruct routine only because a code component has&amp;#10;#   to live in some routine. The &quot;Experiment&quot; tabs run once per session&amp;#10;#   no matter which routine they are in.&amp;#10;#&amp;#10;# ---------------------------------------------------------------------&amp;#10;# HOW PIXEL MODE TRIGGERS WORK (read this first)&amp;#10;# ---------------------------------------------------------------------&amp;#10;# The DATAPixx3 box sits between the stimulus PC and the projector, so&amp;#10;# every frame the PC draws passes through it. Each time the screen&amp;#10;# refreshes (120 times per second here) the DATAPixx3 looks at ONE&amp;#10;# pixel: the very top-left pixel of the screen.&amp;#10;#&amp;#10;# In &quot;Pixel Mode B&quot; it reads that pixel's BLUE value (a whole number&amp;#10;# from 0 to 255) and puts it out on 8 digital lines. Those lines are&amp;#10;# recorded on the MEG trigger channel. The red and green values are&amp;#10;# ignored, so we always keep them at 0.&amp;#10;#&amp;#10;# Each of these blue values switches on exactly ONE of the 8 lines:&amp;#10;#     1, 2, 4, 8, 16, 32, 64, 128&amp;#10;# Blue = 0 (a black pixel) means all lines are off.&amp;#10;#&amp;#10;# So to &quot;send trigger 2&quot; we colour that one pixel (0, 0, 2) for one&amp;#10;# frame, then make it black again. The pixel is far too dark to see.&amp;#10;#&amp;#10;# Colours are written as (red, green, blue), each from 0 to 255.&amp;#10;# ---------------------------------------------------------------------&amp;#10;&amp;#10;# --- The trigger colours used in this experiment ---------------------&amp;#10;# To add a new trigger, give it one of the unused blue values:&amp;#10;# 8, 16, 32, 64 or 128.&amp;#10;TRIG_FIXATION = (0, 0, 1)   # fixation cross appears   -&gt; MEG trigger 1&amp;#10;TRIG_TARGET_L = (0, 0, 2)   # target appears on LEFT   -&gt; MEG trigger 2&amp;#10;TRIG_TARGET_R = (0, 0, 4)   # target appears on RIGHT  -&gt; MEG trigger 4&amp;#10;TRIG_OFF      = (0, 0, 0)   # black pixel              -&gt; all lines off&amp;#10;&amp;#10;# --- Load VPixx's library --------------------------------------------&amp;#10;# &quot;try / except ImportError&quot; means: try to load pypixxlib; if it is not&amp;#10;# installed on this computer, do not crash - remember that it is&amp;#10;# missing instead. vpixxSetup's Begin Experiment tab then switches to&amp;#10;# dummy mode (no hardware, no triggers) and prints a warning.&amp;#10;#&amp;#10;# &quot;as dp&quot; gives the library the short name dp, so later lines can say&amp;#10;# dp.DPxOpen() instead of typing the full name each time.&amp;#10;try:&amp;#10;    from pypixxlib import _libdpx as dp&amp;#10;    PYPIXXLIB_INSTALLED = True&amp;#10;except ImportError:&amp;#10;    dp = None&amp;#10;    PYPIXXLIB_INSTALLED = False&amp;#10;&amp;#10;# atexit is a standard Python module. It lets us register a function&amp;#10;# that Python runs automatically when the experiment quits (see the&amp;#10;# Begin Experiment tab, step 4).&amp;#10;import atexit&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# =====================================================================&amp;#10;# vpixxSetup  -  &quot;Begin Experiment&quot; tab&amp;#10;# =====================================================================&amp;#10;# WHEN THIS RUNS: once, after the participant dialog box is closed and&amp;#10;#   the window has opened, before the first routine starts.&amp;#10;# WHAT IT DOES:&amp;#10;#   1. decides between real hardware and dummy mode&amp;#10;#   2. stops the run if the window is not full screen&amp;#10;#   3. connects to the DATAPixx3 and turns on Pixel Mode B&amp;#10;#   4. makes sure the DATAPixx3 is released when the experiment quits&amp;#10;#   5. creates the 1x1 trigger pixel&amp;#10;#   6. defines the two functions the trial routine uses to send triggers&amp;#10;#&amp;#10;# WHY THIS CODE IS HERE AND NOT IN &quot;Before Experiment&quot;:&amp;#10;#   Builder puts this tab inside a function called run(). The window&amp;#10;#   (win), the data file (thisExp) and the dialog answers (expInfo) only&amp;#10;#   exist inside run(), so any code that uses them has to live here.&amp;#10;#&amp;#10;# NAMES USED HERE THAT COME FROM ELSEWHERE:&amp;#10;#   win, thisExp, expInfo, PILOTING, logging, visual  -&gt; created by Builder&amp;#10;#   dp, PYPIXXLIB_INSTALLED, atexit, TRIG_...         -&gt; vpixxSetup's&amp;#10;#                                                        Before Experiment tab&amp;#10;# =====================================================================&amp;#10;&amp;#10;# --- Step 1: real hardware or dummy mode? ----------------------------&amp;#10;# expInfo holds the answers typed into the dialog box at the start.&amp;#10;# The dummy_vpixx box arrives as True or False. Comparing its text with&amp;#10;# 'True' works whether Builder hands it over as True or as 'True'.&amp;#10;DUMMY_VPIXX = str(expInfo['dummy_vpixx']) == 'True'&amp;#10;&amp;#10;# Without pypixxlib we cannot talk to the hardware, so force dummy mode&amp;#10;# and print a loud warning in the Runner window.&amp;#10;if not PYPIXXLIB_INSTALLED and not DUMMY_VPIXX:&amp;#10;    logging.warning('pypixxlib is not installed: running in dummy mode, '&amp;#10;                    'NO TRIGGERS WILL BE SENT')&amp;#10;    DUMMY_VPIXX = True&amp;#10;&amp;#10;# Save the mode in the data file so you can tell a dummy run apart later.&amp;#10;thisExp.addData('dummy_vpixx', DUMMY_VPIXX)&amp;#10;&amp;#10;# --- Step 2: stop if the window is not full screen -------------------&amp;#10;# The DATAPixx3 reads the top-left pixel of the whole SCREEN. If our&amp;#10;# window is smaller than the screen, that pixel belongs to the desktop,&amp;#10;# and the trigger lines show whatever colour the desktop has there.&amp;#10;# Builder's Pilot mode always uses a small window, so it would cause&amp;#10;# exactly that. PILOTING is True in Pilot mode; win.fullscr is True when&amp;#10;# the window covers the whole screen. &quot;raise RuntimeError&quot; stops the&amp;#10;# experiment with this message.&amp;#10;if not DUMMY_VPIXX and (PILOTING or not win.fullscr):&amp;#10;    message = ('VPixx Pixel Mode triggers need a FULL-SCREEN window in RUN '&amp;#10;               'mode. Switch Builder from Pilot to Run, or tick dummy_vpixx '&amp;#10;               'to test without triggers.')&amp;#10;    logging.error(message)&amp;#10;    raise RuntimeError(message)&amp;#10;&amp;#10;# --- Step 3: connect to the DATAPixx3 and turn on Pixel Mode B -------&amp;#10;# pypixxlib changes settings in a copy kept on this PC (the &quot;register&amp;#10;# cache&quot;). Nothing reaches the device until DPxWriteRegCache() sends&amp;#10;# that copy over USB.&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxOpen()                    # connect to the DATAPixx3 over USB&amp;#10;    dp.DPxStopAllScheds()           # stop anything an earlier script left running&amp;#10;    dp.DPxEnableDoutPixelModeB()    # Pixel Mode B: top-left blue value -&gt; trigger lines&amp;#10;    dp.DPxWriteRegCache()           # send these settings to the device&amp;#10;&amp;#10;&amp;#10;# --- Step 4: release the DATAPixx3 when the experiment quits ---------&amp;#10;# &quot;def&quot; defines a function: a named block of code that runs later,&amp;#10;# each time something calls it by name.&amp;#10;def close_vpixx():&amp;#10;    &quot;&quot;&quot;Turn Pixel Mode off and disconnect from the DATAPixx3.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return                      # nothing to close in dummy mode&amp;#10;    try:&amp;#10;        dp.DPxDisableDoutPixelMode()    # stop driving the trigger lines&amp;#10;        dp.DPxWriteRegCache()           # send that change to the device&amp;#10;        dp.DPxClose()                   # disconnect&amp;#10;    except Exception:&amp;#10;        pass    # the device was already closed or unplugged: nothing to do&amp;#10;&amp;#10;# atexit.register() asks Python to run close_vpixx when the experiment&amp;#10;# quits. This happens both at a normal end AND when you press Esc.&amp;#10;# That is why there is no &quot;End Experiment&quot; code: Builder skips&amp;#10;# End Experiment code when Esc is pressed, but atexit still runs.&amp;#10;atexit.register(close_vpixx)&amp;#10;&amp;#10;# --- Step 5: create the trigger pixel --------------------------------&amp;#10;# A rectangle 1 pixel wide and 1 pixel high. In pixel units, (0, 0) is&amp;#10;# the CENTRE of the screen, so the top-left corner is at&amp;#10;# (-width/2, +height/2). Adding/subtracting 0.5 puts the centre of our&amp;#10;# 1-pixel square in the middle of that corner pixel.&amp;#10;#   colorSpace='rgb255' -&gt; colours are given as (R, G, B) from 0 to 255,&amp;#10;#                          exactly like the TRIG_ values&amp;#10;#   lineWidth=0         -&gt; no outline around the square&amp;#10;#   setAutoDraw(True)   -&gt; PsychoPy redraws it on every frame, in every&amp;#10;#                          routine, until the experiment ends&amp;#10;screen_width, screen_height = win.size&amp;#10;trigger_pixel = visual.Rect(&amp;#10;    win,&amp;#10;    units='pix',&amp;#10;    width=1,&amp;#10;    height=1,&amp;#10;    pos=(-screen_width / 2 + 0.5, screen_height / 2 - 0.5),&amp;#10;    colorSpace='rgb255',&amp;#10;    fillColor=TRIG_OFF,&amp;#10;    lineColor=TRIG_OFF,&amp;#10;    lineWidth=0,&amp;#10;    interpolate=False,&amp;#10;    autoLog=False,&amp;#10;)&amp;#10;trigger_pixel.setAutoDraw(True)&amp;#10;&amp;#10;&amp;#10;# --- Step 6: functions the trial routine uses ------------------------&amp;#10;def set_trigger_pixel(colour):&amp;#10;    &quot;&quot;&quot;Give the trigger pixel a new colour, e.g. TRIG_FIXATION or TRIG_OFF.&amp;#10;&amp;#10;    The change appears at the next screen refresh (the next win.flip()).&amp;#10;    &quot;&quot;&quot;&amp;#10;    trigger_pixel.fillColor = colour&amp;#10;    trigger_pixel.lineColor = colour&amp;#10;&amp;#10;&amp;#10;def record_vpixx_time(column_name):&amp;#10;    &quot;&quot;&quot;Save the DATAPixx3's own clock time in the data file.&amp;#10;&amp;#10;    send_trigger() arranges for this to run immediately after the screen&amp;#10;    refresh that showed the trigger, so the time stamps the trigger.&amp;#10;    &quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return                          # no device, no clock: leave the cell empty&amp;#10;    dp.DPxUpdateRegCache()              # fetch fresh values from the device (incl. its clock)&amp;#10;    thisExp.addData(column_name, dp.DPxGetTime())&amp;#10;&amp;#10;&amp;#10;def send_trigger(colour, stim_name):&amp;#10;    &quot;&quot;&quot;Show a trigger colour on the next screen refresh and log it.&amp;#10;&amp;#10;    colour    : one of the TRIG_ values, e.g. TRIG_TARGET_L&amp;#10;    stim_name : the stimulus it belongs to, e.g. 'target'; used to name&amp;#10;                the data file columns 'target.trigger' and 'target.vp'&amp;#10;    &quot;&quot;&quot;&amp;#10;    set_trigger_pixel(colour)&amp;#10;    # colour[2] is the third number in (R, G, B): the blue value, which&amp;#10;    # is the trigger number recorded on the MEG.&amp;#10;    thisExp.addData(stim_name + '.trigger', colour[2])&amp;#10;    # win.callOnFlip(function, argument) runs the function right after&amp;#10;    # the next screen refresh, the one that shows this trigger.&amp;#10;    win.callOnFlip(record_vpixx_time, stim_name + '.vp')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="vpixxSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="taskInstructions" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="32" valType="num" updates="constant" name="letterHeight"/>
        <Param val="taskInstructions" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Reaction time task&amp;#10;&amp;#10;Keep your eyes on the cross in the centre of the screen.&amp;#10;&amp;#10;A white dot will appear on the LEFT or RIGHT.&amp;#10;&amp;#10;LEFT dot  -&gt;  LEFT index finger&amp;#10;RIGHT dot  -&gt;  RIGHT index finger&amp;#10;&amp;#10;Respond as quickly and accurately as you can.&amp;#10;&amp;#10;Press either button to start." valType="str" updates="constant" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1400" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="ready" plugin="None">
        <Param val="'7', '2'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="ready" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="last key" valType="str" updates="constant" name="store"/>
        <Param val="False" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="trial">
      <RoutineSettingsComponent name="trial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="trial" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="stimSettings" plugin="None">
        <Param val="# =====================================================================&amp;#10;# stimSettings  -  &quot;Before Experiment&quot; tab&amp;#10;# =====================================================================&amp;#10;# WHEN THIS RUNS: once, when the experiment starts.&amp;#10;# WHAT IT DOES: turns stimulus sizes in degrees of visual angle into&amp;#10;#   pixels, because the experiment draws in pixel units.&amp;#10;# WHERE IT IS: first in the trial routine so it is the first thing you&amp;#10;#   see. Its position does not affect when it runs: Before Experiment&amp;#10;#   code always runs before anything is drawn.&amp;#10;#&amp;#10;# EDIT HERE if the screen, the viewing distance or the stimulus sizes&amp;#10;# change. Everything below the line is worked out from these numbers.&amp;#10;# =====================================================================&amp;#10;&amp;#10;# --- Display (MEG lab) -------------------------------------------------&amp;#10;SCREEN_WIDTH_PX = 1920        # horizontal resolution, pixels&amp;#10;SCREEN_WIDTH_CM = 60.6        # width of the visible image, cm&amp;#10;VIEWING_DISTANCE_CM = 95.0    # eye to screen, cm&amp;#10;&amp;#10;# --- Stimulus sizes, degrees of visual angle ---------------------------&amp;#10;FIXATION_SIZE_DEG = 0.6       # width and height of the fixation cross&amp;#10;TARGET_SIZE_DEG = 1.5         # diameter of the target dot&amp;#10;TARGET_OFFSET_DEG = 6.0       # distance of the target from screen centre&amp;#10;&amp;#10;# --- Degrees -&gt; pixels (no need to edit below this line) ---------------&amp;#10;# &quot;import math&quot; loads Python's maths functions (tan, radians, ...).&amp;#10;import math&amp;#10;&amp;#10;# Step 1: pixels per centimetre on the screen.&amp;#10;#   1920 px / 60.6 cm = about 31.7 px per cm&amp;#10;PIX_PER_CM = SCREEN_WIDTH_PX / SCREEN_WIDTH_CM&amp;#10;&amp;#10;# Step 2: how many centimetres one degree covers at the screen centre.&amp;#10;#   Picture a triangle from the eye to the screen: the viewing distance&amp;#10;#   is one side, and 1 degree is the angle at the eye. Splitting it into&amp;#10;#   two halves of 0.5 degree each gives two right-angled triangles, so&amp;#10;#   1 degree spans 2 x distance x tan(0.5 degree) on the screen.&amp;#10;#   math.radians() converts degrees to radians, which math.tan() needs.&amp;#10;#   95 cm away -&gt; about 1.66 cm per degree&amp;#10;CM_PER_DEG = 2 * VIEWING_DISTANCE_CM * math.tan(math.radians(0.5))&amp;#10;&amp;#10;# Step 3: pixels per degree = pixels per cm x cm per degree&amp;#10;#   (about 52.5 for the MEG lab display).&amp;#10;PIX_PER_DEG = PIX_PER_CM * CM_PER_DEG&amp;#10;&amp;#10;# Step 4: sizes in whole pixels. round() turns e.g. 78.8 into 79.&amp;#10;fixSizePix = round(FIXATION_SIZE_DEG * PIX_PER_DEG)       # used by: fixation (Size)&amp;#10;targetSizePix = round(TARGET_SIZE_DEG * PIX_PER_DEG)      # used by: target (Size)&amp;#10;targetOffsetPix = round(TARGET_OFFSET_DEG * PIX_PER_DEG)  # used by: target (Position)&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="stimSettings" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="trialSetup" plugin="None">
        <Param val="# =====================================================================&amp;#10;# trialSetup  -  &quot;Before Experiment&quot; tab&amp;#10;# =====================================================================&amp;#10;# WHEN THIS RUNS: once, when the experiment starts.&amp;#10;# WHAT IT DOES: sets the trial timing, in seconds.&amp;#10;#&amp;#10;# A trial runs like this:&amp;#10;#   blank screen (ITI) -&gt; fixation cross appears -&gt; random wait&amp;#10;#   (the foreperiod) -&gt; target appears -&gt; response or deadline&amp;#10;#&amp;#10;# These names are used in the Start/Stop fields of fixation, target and&amp;#10;# resp (open each component in Builder to see them).&amp;#10;# =====================================================================&amp;#10;ITI = 0.5               # blank screen at the start of each trial&amp;#10;FOREPERIOD_MIN = 0.8    # shortest wait from fixation to target&amp;#10;FOREPERIOD_MAX = 1.5    # longest wait from fixation to target&amp;#10;RESP_DEADLINE = 1.5     # how long the target stays up waiting for a response&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# =====================================================================&amp;#10;# trialSetup  -  &quot;Begin Routine&quot; tab&amp;#10;# =====================================================================&amp;#10;# WHEN THIS RUNS: at the start of every trial, before anything is drawn.&amp;#10;# WHAT IT DOES: picks this trial's random foreperiod.&amp;#10;# WHERE IT IS: before fixation, target and resp, because their Start and&amp;#10;#   Stop times use the variable foreperiod. Builder runs components from&amp;#10;#   top to bottom, so foreperiod must exist before they need it.&amp;#10;#&amp;#10;# random() gives a random number between 0 and 1 (Builder loads it for&amp;#10;# you). Scaling it gives a number between FOREPERIOD_MIN and&amp;#10;# FOREPERIOD_MAX, every value equally likely. Example: 0.8 + 0.5 x 0.7&amp;#10;# = 1.15 seconds.&amp;#10;# =====================================================================&amp;#10;foreperiod = FOREPERIOD_MIN + random() * (FOREPERIOD_MAX - FOREPERIOD_MIN)&amp;#10;&amp;#10;# addData(column, value) writes a value into this trial's row of the&amp;#10;# data file.&amp;#10;thisExp.addData('foreperiod', foreperiod)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# =====================================================================&amp;#10;# trialSetup  -  &quot;End Routine&quot; tab&amp;#10;# =====================================================================&amp;#10;# WHEN THIS RUNS: at the end of every trial (after a response, or when&amp;#10;#   the deadline passes).&amp;#10;# WHAT IT DOES: records whether the participant responded, and makes&amp;#10;#   sure the trigger pixel is black before the next trial.&amp;#10;# =====================================================================&amp;#10;&amp;#10;# resp.keys holds the key that was pressed ('7' or '2'), or nothing if&amp;#10;# no key was pressed in time. &quot;not resp.keys&quot; is True when it is empty.&amp;#10;if not resp.keys:&amp;#10;    thisExp.addData('timeout', 1)   # no response before the deadline&amp;#10;else:&amp;#10;    thisExp.addData('timeout', 0)   # responded in time&amp;#10;&amp;#10;# Safety step: trigger pixel back to black between trials.&amp;#10;# set_trigger_pixel and TRIG_OFF come from the vpixxSetup component.&amp;#10;set_trigger_pixel(TRIG_OFF)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trialSetup" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <PolygonComponent name="fixation" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="white" valType="color" updates="constant" name="lineColor"/>
        <Param val="1" valType="num" updates="constant" name="lineWidth"/>
        <Param val="4" valType="int" updates="constant" name="nVertices"/>
        <Param val="fixation" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="cross" valType="str" updates="None" name="shape"/>
        <Param val="(fixSizePix, fixSizePix)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="ITI" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="foreperiod + RESP_DEADLINE" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
      <PolygonComponent name="target" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="white" valType="color" updates="constant" name="fillColor"/>
        <Param val="linear" valType="str" updates="constant" name="interpolate"/>
        <Param val="white" valType="color" updates="constant" name="lineColor"/>
        <Param val="1" valType="num" updates="constant" name="lineWidth"/>
        <Param val="4" valType="int" updates="constant" name="nVertices"/>
        <Param val="target" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(targetX * targetOffsetPix, 0)" valType="list" updates="set every repeat" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="circle" valType="str" updates="None" name="shape"/>
        <Param val="(targetSizePix, targetSizePix)" valType="list" updates="constant" name="size"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="ITI + foreperiod" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="RESP_DEADLINE" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
      <KeyboardComponent name="resp" plugin="None">
        <Param val="'7', '2'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="$corrAns" valType="str" updates="constant" name="correctAns"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="resp" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="ITI + foreperiod" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="RESP_DEADLINE" valType="code" updates="constant" name="stopVal"/>
        <Param val="first key" valType="str" updates="constant" name="store"/>
        <Param val="True" valType="bool" updates="constant" name="storeCorrect"/>
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="onsetTriggers" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# =====================================================================&amp;#10;# onsetTriggers  -  &quot;Each Frame&quot; tab&amp;#10;# =====================================================================&amp;#10;# WHEN THIS RUNS: on every screen refresh during the trial, 120 times&amp;#10;#   per second.&amp;#10;# WHAT IT DOES: sends trigger 1 when the fixation cross appears and&amp;#10;#   trigger 2 or 4 when the target appears.&amp;#10;#&amp;#10;# WHERE IT IS - THIS MATTERS: it must stay BELOW fixation and target.&amp;#10;#   On each frame Builder goes through the components from top to&amp;#10;#   bottom, then refreshes the screen. When a stimulus is due, its&amp;#10;#   component switches it on during that pass. Because this component&amp;#10;#   comes after them, it sees the stimulus switch on in the SAME pass,&amp;#10;#   so the trigger and the stimulus appear on the same screen refresh.&amp;#10;#   Moved above them, every trigger would be one frame (8.3 ms) late.&amp;#10;#&amp;#10;# NAMES USED HERE THAT COME FROM ELSEWHERE:&amp;#10;#   frameN                 -&gt; Builder: number of the current frame in&amp;#10;#                             this trial (0, 1, 2, ...)&amp;#10;#   fixation, target       -&gt; the stimulus components in this routine&amp;#10;#   STARTED                -&gt; Builder: status of a stimulus on screen&amp;#10;#   .frameNStart           -&gt; Builder: the frame number a stimulus&amp;#10;#                             appeared on&amp;#10;#   targetSide             -&gt; conditions.csv: 'left' or 'right'&amp;#10;#   set_trigger_pixel, send_trigger, TRIG_... -&gt; vpixxSetup component&amp;#10;# =====================================================================&amp;#10;&amp;#10;# Step 1: start every frame with the trigger pixel black.&amp;#10;# If a trigger was sent on the previous frame, this switches it off, so&amp;#10;# each trigger lasts exactly one frame (8.3 ms, about 10 MEG samples at&amp;#10;# 1200 Hz). On frames with nothing new, the pixel simply stays black.&amp;#10;set_trigger_pixel(TRIG_OFF)&amp;#10;&amp;#10;# Step 2: did the fixation cross appear on this frame?&amp;#10;# Both conditions must be true: the cross is on screen, AND the frame it&amp;#10;# appeared on is this one. That is true on exactly one frame per trial.&amp;#10;if fixation.status == STARTED and fixation.frameNStart == frameN:&amp;#10;    send_trigger(TRIG_FIXATION, 'fixation')&amp;#10;&amp;#10;# Step 3: did the target appear on this frame?&amp;#10;# Choose the trigger by the side the target is on in this trial.&amp;#10;if target.status == STARTED and target.frameNStart == frameN:&amp;#10;    if targetSide == 'left':&amp;#10;        send_trigger(TRIG_TARGET_L, 'target')&amp;#10;    else:&amp;#10;        send_trigger(TRIG_TARGET_R, 'target')&amp;#10;&amp;#10;# Step 2 or 3 overrides Step 1 on an onset frame, because the colour&amp;#10;# that counts is the last one set before the screen refreshes.&amp;#10;# To make triggers last longer than one frame, replace&amp;#10;# &quot;fixation.frameNStart == frameN&quot; with&amp;#10;# &quot;frameN &lt; fixation.frameNStart + 3&quot; (3 frames), and the same for target.&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="onsetTriggers" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="thanks">
      <RoutineSettingsComponent name="thanks" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="thanks" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <TextComponent name="thanksText" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
        <Param val="Arial" valType="str" updates="constant" name="font"/>
        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="32" valType="num" updates="constant" name="letterHeight"/>
        <Param val="thanksText" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="3.0" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Thank you!&amp;#10;&amp;#10;The task is complete." valType="str" updates="constant" name="text"/>
        <Param val="pix" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1400" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="instruct"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="code"/>
      <Param name="conditions" updates="None" val="[OrderedDict({'targetSide': 'left', 'targetX': np.int64(-1), 'corrAns': np.int64(7)}), OrderedDict({'targetSide': 'right', 'targetX': np.int64(1), 'corrAns': np.int64(2)})]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="20" valType="code"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="trials"/>
    <Routine name="thanks"/>
  </Flow>
</PsychoPy2experiment>
