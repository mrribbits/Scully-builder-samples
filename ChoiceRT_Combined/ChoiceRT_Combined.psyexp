      <CodeComponent name="elConfig" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# elConfig  |  &quot;Begin Routine&quot; tab  |  routine: eyelinkSetup&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, at the start of the eyelinkSetup routine, before&amp;#10;#               the eye tracker is calibrated.&amp;#10;#&amp;#10;# WHAT IT DOES: sets the eye tracker to record 500 samples per second&amp;#10;#               (500 Hz). In Remote Mode, 500 Hz is the fastest rate the&amp;#10;#               EyeLink 1000 Plus can record.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   pylink     - SR Research's Python library for controlling the eye&amp;#10;#                tracker. The EyeLink &quot;Initialize&quot; component in this&amp;#10;#                routine loads it, so you don't have to import it.&amp;#10;#   dummy_mode - True or False, also created by the Initialize component.&amp;#10;#                True means &quot;no eye tracker is connected, just pretend&quot;.&amp;#10;#                Use it to test the experiment on a computer with no&amp;#10;#                tracker. Turn it on with the &quot;Dummy Mode&quot; tick box on&amp;#10;#                the Initialize component.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# Get the connection to the eye tracker. The Initialize component opened&amp;#10;# it when the experiment started.&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;&amp;#10;# Only send settings when a real eye tracker is connected.&amp;#10;if not dummy_mode:&amp;#10;    # Put the tracker in &quot;offline&quot; mode (idle, not recording). Its&amp;#10;    # settings can only be changed while it is offline.&amp;#10;    el_tracker.setOfflineMode()&amp;#10;&amp;#10;    # Record at 500 samples per second.&amp;#10;    el_tracker.sendCommand(&quot;sample_rate 500&quot;)&amp;#10;&amp;#10;    # Remote Mode itself (no chin rest; a small target sticker on the&amp;#10;    # participant's forehead) is chosen on the EyeLink Host PC, under&amp;#10;    # &quot;Set Options&quot;. To choose it from this experiment instead, delete&amp;#10;    # the &quot;#&quot; at the start of the next line.&amp;#10;    # RTABLER means: desktop mount, remote mode, one eye.&amp;#10;    # el_tracker.sendCommand(&quot;elcl_select_configuration = RTABLER&quot;)&amp;#10;&amp;#10;    # Write a note into the eye-tracking data file (the &quot;EDF&quot; file) so&amp;#10;    # anyone analysing it later can see which settings were used.&amp;#10;    el_tracker.sendMessage(&quot;SESSION_CONFIG remote_mode sample_rate_500&quot;)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="elConfig" valType="code" updates="None" name="name" />
      </CodeComponent>
