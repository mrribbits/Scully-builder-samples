    <Routine name="trial">
      <RoutineSettingsComponent name="trial" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="trial" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="stimSettings" plugin="None">
        <Param val="# ======================================================================&amp;#10;# stimSettings  |  &quot;Before Experiment&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, before the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: works out how big the fixation cross should be in PIXELS&amp;#10;#               (the unit this experiment uses), starting from its size&amp;#10;#               in DEGREES OF VISUAL ANGLE (the unit papers report).&amp;#10;#               Same numbers as the other ChoiceRT versions.&amp;#10;#&amp;#10;# WHERE IT IS: first in the trial routine so it's the first thing you&amp;#10;#   see. Its position doesn't affect when it runs: Before Experiment&amp;#10;#   code always runs before anything is drawn.&amp;#10;#&amp;#10;# EDIT THE NUMBERS BELOW if the screen, the viewing distance or the&amp;#10;# cross size change. The fixation component and the EyeLink Host PC&amp;#10;# drawing both use the pixel size calculated at the bottom.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# &quot;math&quot; is Python's built-in maths library. We need it for tan().&amp;#10;import math&amp;#10;&amp;#10;# ---- The display (MEG lab projector) --------------------------------&amp;#10;screenWidthCm = 60.6        # width of the image on the screen, in cm&amp;#10;screenWidthPix = 1920       # number of pixels across the screen&amp;#10;viewingDistanceCm = 95      # distance from the eyes to the screen, in cm&amp;#10;&amp;#10;# ---- Stimulus size, in degrees of visual angle ----------------------&amp;#10;fixationSizeDeg = 0.6       # width and height of the central cross&amp;#10;&amp;#10;# ---- Convert degrees to pixels --------------------------------------&amp;#10;# Step 1: how many centimetres 1 degree covers at the screen centre.&amp;#10;#   Picture a triangle from the eye to the screen: the viewing distance&amp;#10;#   is one side, and 1 degree is the angle at the eye. Splitting it into&amp;#10;#   two halves of 0.5 degree gives two right-angled triangles, so&amp;#10;#   1 degree spans 2 x distance x tan(0.5 degree) on the screen.&amp;#10;#   math.radians() converts degrees to radians, which tan() expects.&amp;#10;cmPerDeg = 2 * viewingDistanceCm * math.tan(math.radians(0.5))   # ~1.66 cm&amp;#10;&amp;#10;# Step 2: how many pixels fit in 1 cm of screen.&amp;#10;pixPerCm = screenWidthPix / screenWidthCm                        # ~31.7 px&amp;#10;&amp;#10;# Step 3: how many pixels make up 1 degree.&amp;#10;pixPerDeg = cmPerDeg * pixPerCm                                  # ~52.5 px&amp;#10;&amp;#10;# Step 4: final size in whole pixels. round() turns e.g. 31.5 into 32.&amp;#10;# The fixation component's Size field is (fixationSizePix, fixationSizePix).&amp;#10;fixationSizePix = round(fixationSizeDeg * pixPerDeg)             # 32 px&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="stimSettings" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="trialSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;Before Experiment&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, before the experiment window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: sets the trial timing, in seconds.&amp;#10;#&amp;#10;# A trial runs like this:&amp;#10;#   blank screen (ITI) -&gt; fixation cross appears -&gt; random wait&amp;#10;#   (the foreperiod) -&gt; tone -&gt; up to responseWindow seconds to answer.&amp;#10;#   The cross stays on until the end of the trial.&amp;#10;#&amp;#10;# These names are used in the Start/Stop fields of fixation and resp&amp;#10;# (open each component in Builder to see them).&amp;#10;# ======================================================================&amp;#10;&amp;#10;ITI = 0.5                  # blank screen at the start of each trial&amp;#10;foreperiodMin = 0.8        # shortest wait from fixation to tone&amp;#10;foreperiodMax = 1.5        # longest wait from fixation to tone&amp;#10;responseWindow = 1.5       # time allowed to answer, from tone onset&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;Begin Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the start of every trial, before anything is drawn.&amp;#10;#&amp;#10;# WHAT IT DOES: picks this trial's random wait, works out when the tone&amp;#10;#               starts, and gives the DATAPixx3 this trial's audio&amp;#10;#               schedule (which ear) without starting it yet.&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   toneSide - conditions.csv: 'left' or 'right' for this trial. The&amp;#10;#              trials loop sets one value per trial, in random order.&amp;#10;#   np, sampleRate, toneWave, toneMemoryAddress - toneSetup.&amp;#10;#   dp, DUMMY_VPIXX - vpixxSetup.&amp;#10;#   vpixxTimes      - triggerSetup.&amp;#10;#&amp;#10;# WHY IT SITS ABOVE THE fixation AND resp COMPONENTS:&amp;#10;#   fixation's duration and resp's start time use foreperiod and&amp;#10;#   toneOnset, so they must be set first. Builder runs components from&amp;#10;#   top to bottom.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# A random number between foreperiodMin and foreperiodMax, every value&amp;#10;# equally likely. Making the wait random stops the participant from&amp;#10;# predicting when the tone will come.&amp;#10;foreperiod = np.random.uniform(foreperiodMin, foreperiodMax)&amp;#10;thisExp.addData('foreperiod', foreperiod)&amp;#10;&amp;#10;# When the tone starts, in seconds from the start of the trial. The&amp;#10;# resp component starts listening at this time too, so its reaction&amp;#10;# time (resp.rt) is measured from the tone.&amp;#10;toneOnset = ITI + foreperiod&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    # The audio schedule: start at once when told (0.0), play at&amp;#10;    # sampleRate, play all the tone's samples, send them to toneSide&amp;#10;    # ('left' or 'right' ear only) and read them from toneMemoryAddress.&amp;#10;    dp.DPxSetAudioSchedule(0.0, sampleRate, len(toneWave), toneSide,&amp;#10;                           toneMemoryAddress)&amp;#10;    dp.DPxWriteRegCache()   # send it to the DATAPixx3 (not started yet)&amp;#10;&amp;#10;# onsetEvents sets this to True once it has started the tone, so the&amp;#10;# tone is only started once per trial.&amp;#10;toneStarted = False&amp;#10;&amp;#10;# Forget last trial's DATAPixx3 clock times. .clear() empties the dict.&amp;#10;vpixxTimes.clear()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialSetup  |  &quot;End Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of every trial, either after a button press&amp;#10;#               or when the response window runs out.&amp;#10;#&amp;#10;# WHAT IT DOES: 1) works out what happened on this trial;&amp;#10;#               2) writes a summary of it into the eye-tracking data&amp;#10;#                  file (EDF).&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   resp     - the Keyboard component in this routine.&amp;#10;#   pylink   - SR Research's eye-tracker library, loaded by the EyeLink&amp;#10;#              Initialize component.&amp;#10;#   trials   - Builder: the trials loop. trials.thisN counts from 0.&amp;#10;#   toneSide - conditions.csv.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1) What happened on this trial? --------------------------------&amp;#10;# If no button was pressed, resp.keys is empty, and &quot;not resp.keys&quot; is&amp;#10;# True.&amp;#10;if not resp.keys:&amp;#10;    timeout = 1          # 1 = no answer before the response window ended&amp;#10;    respKey = 'NA'       # NA = &quot;not available&quot; (nothing was pressed)&amp;#10;    respRT = 'NA'&amp;#10;    respCorr = 0&amp;#10;else:&amp;#10;    timeout = 0          # 0 = a button was pressed in time&amp;#10;    respKey = resp.keys              # the button pressed: '7' or '2'&amp;#10;    respRT = round(resp.rt, 4)       # reaction time in seconds, timed&amp;#10;                                     # from tone onset, to 4 decimals&amp;#10;    respCorr = resp.corr             # 1 = correct button, 0 = wrong one&amp;#10;&amp;#10;# Save the timeout flag as a column in PsychoPy's data file. (The&amp;#10;# Keyboard component saves the key, reaction time and accuracy there by&amp;#10;# itself.)&amp;#10;thisExp.addData('timeout', timeout)&amp;#10;&amp;#10;# ---- 2) Messages for the eye-tracking data file (EDF) ---------------&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;&amp;#10;# One line summarising the trial. In the text below, each %d is replaced&amp;#10;# by a whole number and each %s by text, in the order listed after the&amp;#10;# &quot;%&quot; sign. Add 1 to trials.thisN to number trials from 1.&amp;#10;el_tracker.sendMessage('TRIAL_SUMMARY trial=%d side=%s key=%s rt=%s corr=%d timeout=%d'&amp;#10;                       % (trials.thisN + 1, toneSide, respKey, respRT, respCorr, timeout))&amp;#10;&amp;#10;# Messages that start with &quot;!V TRIAL_VAR&quot; become trial variables in&amp;#10;# SR Research's Data Viewer program.&amp;#10;el_tracker.sendMessage('!V TRIAL_VAR timeout %d' % timeout)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialSetup" valType="code" updates="None" name="name" />
      </CodeComponent>
      <PolygonComponent name="fixation" plugin="None">
        <Param val="center" valType="str" updates="constant" name="anchor" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="white" valType="color" updates="constant" name="fillColor" />
        <Param val="linear" valType="str" updates="constant" name="interpolate" />
        <Param val="white" valType="color" updates="constant" name="lineColor" />
        <Param val="1" valType="num" updates="constant" name="lineWidth" />
        <Param val="4" valType="int" updates="constant" name="nVertices" />
        <Param val="fixation" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="cross" valType="str" updates="None" name="shape" />
        <Param val="(fixationSizePix, fixationSizePix)" valType="list" updates="constant" name="size" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="ITI" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="foreperiod + responseWindow" valType="code" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="" valType="list" updates="constant" name="vertices" />
      </PolygonComponent>
      <KeyboardComponent name="resp" plugin="None">
        <Param val="&quot;7&quot;,&quot;2&quot;" valType="list" updates="constant" name="allowedKeys" />
        <Param val="$corrAns" valType="str" updates="constant" name="correctAns" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="True" valType="bool" updates="constant" name="discard previous" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine" />
        <Param val="resp" valType="code" updates="None" name="name" />
        <Param val="press" valType="str" updates="constant" name="registerOn" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="toneOnset" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="responseWindow" valType="code" updates="constant" name="stopVal" />
        <Param val="first key" valType="str" updates="constant" name="store" />
        <Param val="True" valType="bool" updates="constant" name="storeCorrect" />
        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh" />
      </KeyboardComponent>
      <CodeComponent name="onsetEvents" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="# ======================================================================&amp;#10;# onsetEvents  |  &quot;Each Frame&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: on every screen refresh (&quot;frame&quot;) during the trial, 120&amp;#10;#               times per second, just before the new frame is shown.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   - when the fixation cross appears: MEG trigger 1&amp;#10;#   - when the tone is due: MEG trigger 2 (left) or 4 (right), the EDF&amp;#10;#     message TONE_ONSET_LEFT/RIGHT, and the tone itself, all on the&amp;#10;#     same screen refresh&amp;#10;#&amp;#10;# WHERE IT IS - THIS MATTERS: it must stay BELOW fixation and resp.&amp;#10;#   On each frame Builder goes through the components from top to&amp;#10;#   bottom, then refreshes the screen. When the cross is due, the&amp;#10;#   fixation component switches it on during that pass. Because this&amp;#10;#   component comes after it, it sees the cross switch on in the SAME&amp;#10;#   pass, so the trigger and the cross appear on the same refresh.&amp;#10;#   Moved above fixation, trigger 1 would be one frame (8.3 ms) late.&amp;#10;#   (The EyeLink MarkEvents component stays at the very bottom.)&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   frameN          - Builder: number of the current frame in this&amp;#10;#                     trial (0, 1, 2, ...).&amp;#10;#   fixation        - the fixation cross component in this routine.&amp;#10;#   STARTED         - Builder: the status of a stimulus that is on.&amp;#10;#   .frameNStart    - Builder: the frame a stimulus appeared on.&amp;#10;#   tThisFlip       - Builder: the time (from the start of the trial)&amp;#10;#                     at which the coming frame will appear.&amp;#10;#   tThisFlipGlobal - Builder: the same moment on PsychoPy's main clock.&amp;#10;#   frameTolerance  - Builder: a tiny margin (0.001 s), so a frame due&amp;#10;#                     at exactly toneOnset isn't missed by rounding.&amp;#10;#   toneOnset, toneStarted - trialSetup.&amp;#10;#   toneSide        - conditions.csv: 'left' or 'right'.&amp;#10;#   setTriggerPixel, sendTrigger, TRIG_... - triggerSetup.&amp;#10;#   dp, DUMMY_VPIXX - vpixxSetup.     dummySounds - toneSetup.&amp;#10;#   pylink          - the EyeLink plugin.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- Step 1: start every frame with the trigger pixel black ----------&amp;#10;# If a trigger was sent on the previous frame, this switches it off, so&amp;#10;# each trigger lasts exactly one frame (8.3 ms, about 10 MEG samples at&amp;#10;# 1200 Hz). Steps 2 and 3 override it on an onset frame, because the&amp;#10;# colour that counts is the last one set before the screen refreshes.&amp;#10;setTriggerPixel(TRIG_OFF)&amp;#10;&amp;#10;# ---- Step 2: did the fixation cross appear on this frame? -----------&amp;#10;# Both must be true: the cross is on screen, AND the frame it appeared&amp;#10;# on is this one. That is true on exactly one frame per trial.&amp;#10;# (The EyeLink MarkEvents component writes the fixation message to the&amp;#10;#  EDF by itself.)&amp;#10;if fixation.status == STARTED and fixation.frameNStart == frameN:&amp;#10;    sendTrigger(TRIG_FIXATION, 'fixation')&amp;#10;&amp;#10;# ---- Step 3: is the tone due on this frame? --------------------------&amp;#10;# This is the same test Builder uses to start resp, so the tone, its&amp;#10;# trigger and resp's reaction-time clock all start on the same frame.&amp;#10;if not toneStarted and tThisFlip &gt;= toneOnset - frameTolerance:&amp;#10;&amp;#10;    # a) EDF message. win.callOnFlip(f, x) means &quot;run f(x) straight&amp;#10;    #    after the next frame appears&quot;, so the message is timed to the&amp;#10;    #    refresh at which the tone starts. .upper() turns 'left' into&amp;#10;    #    'LEFT'. It is queued first so it is sent first after the flip.&amp;#10;    el_tracker = pylink.getEYELINK()&amp;#10;    win.callOnFlip(el_tracker.sendMessage, 'TONE_ONSET_' + toneSide.upper())&amp;#10;&amp;#10;    # b) MEG trigger 2 or 4, on the same refresh. sendTrigger also&amp;#10;    #    saves tone.trigger and, after the refresh, tone.vp.&amp;#10;    if toneSide == 'left':&amp;#10;        sendTrigger(TRIG_TONE_L, 'tone')&amp;#10;    else:&amp;#10;        sendTrigger(TRIG_TONE_R, 'tone')&amp;#10;&amp;#10;    # c) The tone. This must be the LAST VPixx command before the&amp;#10;    #    refresh (see the IMPORTANT note below).&amp;#10;    if not DUMMY_VPIXX:&amp;#10;        # Mark the schedule &quot;start&quot; in the local copy of the settings...&amp;#10;        dp.DPxStartAudSched()&amp;#10;        # ...and send it to the DATAPixx3, which holds it until the next&amp;#10;        # screen refresh, the one Builder is about to show. The tone&amp;#10;        # starts exactly then.&amp;#10;        dp.DPxWriteRegCacheAfterVideoSync()&amp;#10;        # IMPORTANT: between these two lines and the screen refresh,&amp;#10;        # nothing may call dp.DPxUpdateRegCache() or dp.DPxWriteRegCache().&amp;#10;        # Either would replace the pending &quot;start&quot;. (recordVpixxTime&amp;#10;        # calls DPxUpdateRegCache, but only AFTER the refresh, so it is&amp;#10;        # safe.)&amp;#10;    else:&amp;#10;        # Dummy mode: play the PsychoPy sound when the frame is shown.&amp;#10;        # Note &quot;play&quot; without (): we hand over the function so it can be&amp;#10;        # run later, instead of running it now.&amp;#10;        dummySounds[toneSide].stop()          # in case it's still playing&amp;#10;        win.callOnFlip(dummySounds[toneSide].play)&amp;#10;&amp;#10;    # d) The tone's start time on PsychoPy's clock (tone.started).&amp;#10;    toneStartTime = tThisFlipGlobal&amp;#10;    thisExp.addData('tone.started', toneStartTime)&amp;#10;&amp;#10;    toneStarted = True   # don't start it again this trial&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="onsetEvents" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="trialLog" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# trialLog  |  &quot;Begin Experiment&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the experiment starts.&amp;#10;#&amp;#10;# WHAT IT DOES: creates a simple table with ONE ROW PER TRIAL (the&amp;#10;#               &quot;trial log&quot;). Columns are separated by tabs, so it opens&amp;#10;#               in Excel, R, Python, etc. It is saved in this session's&amp;#10;#               folder under &quot;results&quot;, next to the eye-tracking file,&amp;#10;#               and its name ends in &quot;_trials_log.tsv&quot;.&amp;#10;#&amp;#10;# There is no &quot;close the file&quot; step at the end. The EyeLink plugin ends&amp;#10;# the experiment by itself after copying the eye-tracking file, and the&amp;#10;# log is closed automatically then. Each row is saved as soon as it is&amp;#10;# written (see the &quot;End Routine&quot; tab), so nothing is lost.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# thisExp.dataFileName is where PsychoPy saves its own data files,&amp;#10;# without the file extension. Add our own ending to it.&amp;#10;logFileName = thisExp.dataFileName + '_trials_log.tsv'&amp;#10;&amp;#10;# The column names, in order. Each row written later (in the&amp;#10;# &quot;End Routine&quot; tab) must list its values in this same order.&amp;#10;logColumns = ['participant', 'session', 'date', 'edf_file', 'trial',&amp;#10;              'eyelink_trialid', 'tone_side', 'corr_ans', 'foreperiod_s',&amp;#10;              'fixation_onset_s', 'tone_onset_s', 'fixation_vp', 'tone_vp',&amp;#10;              'resp_key', 'rt_s', 'correct', 'timeout', 'dummy_vpixx']&amp;#10;&amp;#10;# Open the file for writing ('w'), then write the row of column names.&amp;#10;# '\t'.join(...) puts a tab between the names; '\n' ends the line.&amp;#10;logFile = open(logFileName, 'w')&amp;#10;logFile.write('\t'.join(logColumns) + '\n')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="# ======================================================================&amp;#10;# trialLog  |  &quot;End Routine&quot; tab  |  routine: trial&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: at the end of every trial.&amp;#10;#&amp;#10;# WHAT IT DOES: adds one row for this trial to the trial log.&amp;#10;#&amp;#10;# WHERE IT IS: below trialSetup, so respKey, respRT, respCorr and&amp;#10;#   timeout have already been worked out there.&amp;#10;#&amp;#10;# WHERE EACH VALUE COMES FROM:&amp;#10;#   expInfo            - the start dialog (participant, session, date)&amp;#10;#   session_identifier - the eye-tracking file name plus the start&amp;#10;#                        time; made by the EyeLink Initialize component&amp;#10;#   trial_index        - the trial number (TRIALID) the EyeLink plugin&amp;#10;#                        wrote into the EDF; use it to match each row to&amp;#10;#                        a trial in the EDF&amp;#10;#   toneSide, corrAns  - this trial's row of conditions.csv&amp;#10;#   fixation.tStartRefresh - when the cross appeared, in seconds on&amp;#10;#                        PsychoPy's clock (0 = start of the experiment)&amp;#10;#   toneStartTime      - when the tone started, same clock (onsetEvents)&amp;#10;#   vpixxTimes         - DATAPixx3 clock times (triggerSetup). .get()&amp;#10;#                        gives None if there is no value (dummy mode).&amp;#10;# ======================================================================&amp;#10;&amp;#10;# The values for this row, in the same order as logColumns.&amp;#10;rowValues = [&amp;#10;    expInfo['participant'],&amp;#10;    expInfo['session'],&amp;#10;    expInfo['date'],&amp;#10;    session_identifier + '.EDF',          # the eye-tracking file&amp;#10;    trials.thisN + 1,                     # trial number, counting from 1&amp;#10;    trial_index,                          # TRIALID in the EDF&amp;#10;    toneSide,                             # 'left' or 'right'&amp;#10;    corrAns,                              # the correct button&amp;#10;    round(foreperiod, 4),                 # wait before the tone (s)&amp;#10;    round(fixation.tStartRefresh, 4),     # when the cross appeared (s)&amp;#10;    round(toneStartTime, 4),              # when the tone started (s)&amp;#10;    vpixxTimes.get('fixation', 'NA'),     # DATAPixx3 clock at the cross&amp;#10;    vpixxTimes.get('tone', 'NA'),         # DATAPixx3 clock at the tone&amp;#10;    respKey,                              # button pressed, or NA&amp;#10;    respRT,                               # reaction time (s), or NA&amp;#10;    respCorr,                             # 1 = correct, 0 = wrong or none&amp;#10;    timeout,                              # 1 = no response in time&amp;#10;    int(DUMMY_VPIXX),                     # 1 = no DATAPixx3 (test run)&amp;#10;]&amp;#10;&amp;#10;# Turn every value into text, put tabs between them, and write the row.&amp;#10;logFile.write('\t'.join(str(value) for value in rowValues) + '\n')&amp;#10;&amp;#10;# flush() saves the row to disk straight away, so the log is complete&amp;#10;# even if the experiment is stopped early with Ctrl-C.&amp;#10;logFile.flush()&amp;#10;" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="trialLog" valType="code" updates="None" name="name" />
      </CodeComponent>
      <MarkEvents name="MarkEvents" plugin="psychopy-eyelink">
        <Param val="" valType="str" updates="None" name="componentsForEyeLinkInterestAreaMessages" />
        <Param val="resp" valType="str" updates="None" name="componentsForEyeLinkRespEventMessages" />
        <Param val="" valType="str" updates="None" name="componentsForEyeLinkStimDVDrawingMessages" />
        <Param val="fixation" valType="str" updates="None" name="componentsForEyeLinkStimEventMessages" />
        <Param val="" valType="str" updates="None" name="componentsForEyeLinkTargetPositionMessages" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="True" valType="bool" updates="None" name="includeAllEventMarkedComponentsForDVDrawingMessages" />
        <Param val="True" valType="bool" updates="None" name="includeAllEventMarkedComponentsForIAMessages" />
        <Param val="20" valType="str" updates="None" name="interestAreaMargins" />
        <Param val="Ellipse" valType="str" updates="constant" name="interestAreaShape" />
        <Param val="MarkEvents" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="False" valType="bool" updates="None" name="sendTrialOnsetOffsetMessages" />
        <Param val="False" valType="bool" updates="None" name="sendVideoFrameMessages" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="0.001" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="toneSide,corrAns,foreperiod" valType="str" updates="None" name="trialConditionVariablesForEyeLinkLogging" />
        <Param val="True" valType="bool" updates="None" name="useQuitKeys" />
      </MarkEvents>
    </Routine>
    <Routine name="eyelinkStopRecording">
      <RoutineSettingsComponent name="eyelinkStopRecording" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="eyelinkStopRecording" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <StopRecording name="StopRecord" plugin="psychopy-eyelink">
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="StopRecord" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0.0" valType="code" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="0.001" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="syncScreenRefresh" />
      </StopRecording>
    </Routine>
    <Routine name="thanks">
      <RoutineSettingsComponent name="thanks" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="thanks" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="pixelModeOff" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# pixelModeOff  |  &quot;Begin Routine&quot; tab  |  routine: thanks&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the final &quot;thank you&quot; screen appears.&amp;#10;#&amp;#10;# WHAT IT DOES: switches Pixel Mode off, so nothing drawn from here on&amp;#10;#               (including the screens the EyeLink plugin shows while&amp;#10;#               it copies the eye-tracking file) can reach the MEG as a&amp;#10;#               trigger.&amp;#10;#&amp;#10;# dp and DUMMY_VPIXX come from vpixxSetup; setTriggerPixel and TRIG_OFF&amp;#10;# from triggerSetup. The DATAPixx3 itself is closed by closeVpixx&amp;#10;# (vpixxSetup) when the program ends.&amp;#10;# ======================================================================&amp;#10;&amp;#10;setTriggerPixel(TRIG_OFF)&amp;#10;&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxDisableDoutPixelMode()     # stop driving the MEG trigger lines&amp;#10;    dp.DPxWriteRegCache()            # send that change to the device&amp;#10;    logging.exp('VPixx Pixel Mode B OFF')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="pixelModeOff" valType="code" updates="None" name="name" />
      </CodeComponent>
      <CodeComponent name="taskEndMsg" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="# ======================================================================&amp;#10;# taskEndMsg  |  &quot;Begin Routine&quot; tab  |  routine: thanks&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, when the final &quot;thank you&quot; screen appears.&amp;#10;#&amp;#10;# WHAT IT DOES: writes TASK_END into the eye-tracking data file (EDF) to&amp;#10;#               mark the end of the task.&amp;#10;# ======================================================================&amp;#10;el_tracker = pylink.getEYELINK()&amp;#10;el_tracker.sendMessage('TASK_END')" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="taskEndMsg" valType="code" updates="None" name="name" />
      </CodeComponent>
      <TextComponent name="endScreen" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color" />
        <Param val="rgb" valType="str" updates="constant" name="colorSpace" />
        <Param val="1" valType="num" updates="constant" name="contrast" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="False" valType="code" updates="constant" name="draggable" />
        <Param val="" valType="num" updates="None" name="durationEstim" />
        <Param val="None" valType="str" updates="constant" name="flip" />
        <Param val="Open Sans" valType="str" updates="constant" name="font" />
        <Param val="LTR" valType="str" updates="None" name="languageStyle" />
        <Param val="36" valType="num" updates="constant" name="letterHeight" />
        <Param val="endScreen" valType="code" updates="None" name="name" />
        <Param val="" valType="num" updates="constant" name="opacity" />
        <Param val="0" valType="num" updates="constant" name="ori" />
        <Param val="(0, 0)" valType="list" updates="constant" name="pos" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="num" updates="None" name="startEstim" />
        <Param val="time (s)" valType="str" updates="None" name="startType" />
        <Param val="0" valType="num" updates="None" name="startVal" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="3" valType="num" updates="constant" name="stopVal" />
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh" />
        <Param val="All done - thank you!&#10;&#10;Please stay still while we save the data." valType="str" updates="constant" name="text" />
        <Param val="pix" valType="str" updates="None" name="units" />
        <Param val="" valType="code" updates="None" name="validator" />
        <Param val="1500" valType="num" updates="constant" name="wrapWidth" />
      </TextComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="eyelinkSetup" />
    <Routine name="instruct" />
    <Routine name="eyelinkDriftCheck" />
    <Routine name="triggersOn" />
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str" />
      <Param name="conditions" updates="None" val="[OrderedDict([('toneSide', 'left'), ('corrAns', '7')]), OrderedDict([('toneSide', 'right'), ('corrAns', '2')])]" valType="str" />
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="str" />
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num" />
      <Param name="isTrials" updates="None" val="True" valType="bool" />
      <Param name="loopType" updates="None" val="random" valType="str" />
      <Param name="nReps" updates="None" val="20" valType="num" />
      <Param name="name" updates="None" val="trials" valType="code" />
      <Param name="random seed" updates="None" val="" valType="code" />
    </LoopInitiator>
    <Routine name="eyelinkStartRecording" />
    <Routine name="trial" />
    <Routine name="eyelinkStopRecording" />
    <LoopTerminator name="trials" />
    <Routine name="thanks" />
  </Flow>
</PsychoPy2experiment>