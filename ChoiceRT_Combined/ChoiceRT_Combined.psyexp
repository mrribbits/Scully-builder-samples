    <Routine name="instruct">
      <RoutineSettingsComponent name="instruct" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="instruct" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="vpixxSetup" plugin="None">
        <Param val="# ======================================================================&amp;#10;# vpixxSetup  |  &quot;Before Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, as soon as the experiment starts, before the start&amp;#10;#               dialog appears and before the window opens.&amp;#10;#&amp;#10;# WHAT IT DOES: loads VPixx's Python library, pypixxlib.&amp;#10;#&amp;#10;# WHAT THE DATAPixx3 DOES IN THIS EXPERIMENT:&amp;#10;#   The DATAPixx3 is VPixx's box that sits between the stimulus PC and&amp;#10;#   the projector. Every frame the PC draws passes through it. Here it&amp;#10;#   has two jobs:&amp;#10;#     1. MEG TRIGGERS. It reads the colour of the top-left screen pixel&amp;#10;#        at every screen refresh and sends it to the MEG as a trigger&amp;#10;#        number (&quot;Pixel Mode&quot;). See triggerSetup.&amp;#10;#     2. SOUND. It plays the tone from its own memory, started exactly&amp;#10;#        at a screen refresh, which the PC's sound card can't do. See&amp;#10;#        toneSetup.&amp;#10;#   This component only does what both jobs need: load the library,&amp;#10;#   connect to the box, and disconnect at the end.&amp;#10;#&amp;#10;# WHY THESE COMPONENTS ARE IN THE instruct ROUTINE:&amp;#10;#   A code component has to live in some routine. The &quot;Experiment&quot; tabs&amp;#10;#   (Before Experiment, Begin Experiment) run once per session, no&amp;#10;#   matter which routine they are in.&amp;#10;#   The three VPixx components must stay in this order: vpixxSetup,&amp;#10;#   triggerSetup, toneSetup. Builder runs their code top to bottom, and&amp;#10;#   the other two use names made here.&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- Load the VPixx library -----------------------------------------&amp;#10;# try / except ImportError means: try to load pypixxlib, and if it isn't&amp;#10;# installed on this computer, carry on without it instead of crashing.&amp;#10;# The Begin Experiment tab then switches to dummy mode (no DATAPixx3).&amp;#10;#&amp;#10;# &quot;as dp&quot; gives the library the short name dp, so later lines can say&amp;#10;# dp.DPxOpen() instead of the full name.&amp;#10;try:&amp;#10;    from pypixxlib import _libdpx as dp&amp;#10;    pypixxlibInstalled = True&amp;#10;except ImportError:&amp;#10;    dp = None&amp;#10;    pypixxlibInstalled = False&amp;#10;&amp;#10;# &quot;atexit&quot; is part of Python. It lets us name a function that must run&amp;#10;# when the program closes, however it closes (see Begin Experiment).&amp;#10;import atexit&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# ======================================================================&amp;#10;# vpixxSetup  |  &quot;Begin Experiment&quot; tab  |  routine: instruct&amp;#10;# ----------------------------------------------------------------------&amp;#10;# WHEN IT RUNS: once, after the start dialog closes and the window&amp;#10;#               opens, before the first routine starts.&amp;#10;#&amp;#10;# WHAT IT DOES:&amp;#10;#   1. decides between the real DATAPixx3 and dummy mode&amp;#10;#   2. stops the run if the window is not full screen&amp;#10;#   3. connects to the DATAPixx3&amp;#10;#   4. makes sure the DATAPixx3 is released when the experiment ends&amp;#10;#&amp;#10;# WHERE THE NAMES COME FROM:&amp;#10;#   expInfo  - Builder: the answers typed into the start dialog.&amp;#10;#   thisExp  - Builder: the data file. thisExp.addData(name, value)&amp;#10;#              adds a column to the current row.&amp;#10;#   win      - Builder: the experiment window.&amp;#10;#   PILOTING - Builder: True when you press Pilot instead of Run.&amp;#10;#   logging  - PsychoPy: writes messages to the console and the log.&amp;#10;#   dp, pypixxlibInstalled, atexit - the Before Experiment tab above.&amp;#10;#&amp;#10;# WHY THIS IS IN &quot;Begin Experiment&quot; AND NOT &quot;Before Experiment&quot;:&amp;#10;#   It needs expInfo (was dummy mode ticked?) and win. Builder only&amp;#10;#   creates those inside its main function, run(), and only the&amp;#10;#   Begin Experiment tab is placed inside run().&amp;#10;# ======================================================================&amp;#10;&amp;#10;# ---- 1. Real DATAPixx3 or dummy mode? --------------------------------&amp;#10;# The &quot;dummy_vpixx&quot; tick box in the start dialog runs the experiment&amp;#10;# without a DATAPixx3, for testing on any computer: no MEG triggers,&amp;#10;# and the tone plays through PsychoPy instead (not precisely timed).&amp;#10;# Comparing its text with 'True' works whether Builder hands the answer&amp;#10;# over as True or as the text 'True'.&amp;#10;DUMMY_VPIXX = str(expInfo['dummy_vpixx']) == 'True'&amp;#10;&amp;#10;# Without pypixxlib we can't talk to a DATAPixx3, so force dummy mode&amp;#10;# and print a loud warning in the Runner window.&amp;#10;if not pypixxlibInstalled and not DUMMY_VPIXX:&amp;#10;    logging.warning('pypixxlib is not installed, so dummy_vpixx was turned '&amp;#10;                    'on: NO MEG TRIGGERS, and tones are NOT precisely timed')&amp;#10;    DUMMY_VPIXX = True&amp;#10;&amp;#10;# Record the mode in the data file, so a dummy run can't be mistaken for&amp;#10;# a real one later.&amp;#10;thisExp.addData('dummy_vpixx', DUMMY_VPIXX)&amp;#10;&amp;#10;# ---- 2. Stop if the window is not full screen ------------------------&amp;#10;# The DATAPixx3 reads the top-left pixel of the whole SCREEN. If our&amp;#10;# window is smaller than the screen, that pixel belongs to the desktop,&amp;#10;# and the MEG trigger lines show whatever colour the desktop has there.&amp;#10;# Builder's Pilot mode always uses a small window, so it would cause&amp;#10;# exactly that. win.fullscr is True when the window covers the screen.&amp;#10;# &quot;raise RuntimeError&quot; stops the experiment with this message.&amp;#10;if not DUMMY_VPIXX and (PILOTING or not win.fullscr):&amp;#10;    message = ('VPixx Pixel Mode triggers need a FULL-SCREEN window in RUN '&amp;#10;               'mode. Switch Builder from Pilot to Run, or tick dummy_vpixx '&amp;#10;               'to test without the DATAPixx3.')&amp;#10;    logging.error(message)&amp;#10;    raise RuntimeError(message)&amp;#10;&amp;#10;# ---- 3. Connect to the DATAPixx3 -------------------------------------&amp;#10;# How VPixx commands work: most dp.DPx... commands only change a local&amp;#10;# copy of the DATAPixx3's settings (the &quot;register cache&quot;) on the&amp;#10;# stimulus PC. Nothing reaches the device until that copy is sent with&amp;#10;# dp.DPxWriteRegCache().&amp;#10;if not DUMMY_VPIXX:&amp;#10;    dp.DPxOpen()                   # connect over USB&amp;#10;    dp.DPxStopAllScheds()          # stop anything an earlier run left playing&amp;#10;    # Pixel Mode OFF for now. EyeLink calibration and the drift check&amp;#10;    # draw their own screens, and their colours must not reach the MEG&amp;#10;    # as triggers. The triggersOn routine switches it on after the&amp;#10;    # drift check (see triggerSetup).&amp;#10;    dp.DPxDisableDoutPixelMode()&amp;#10;    dp.DPxWriteRegCache()          # send these settings to the device&amp;#10;&amp;#10;&amp;#10;# ---- 4. Release the DATAPixx3 when the experiment ends ----------------&amp;#10;# def creates a function: a named block of code that runs later, when&amp;#10;# something calls it by name.&amp;#10;def closeVpixx():&amp;#10;    &quot;&quot;&quot;Stop the sound, switch Pixel Mode off and disconnect.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return                     # nothing to close in dummy mode&amp;#10;    try:&amp;#10;        dp.DPxStopAllScheds()          # stop any sound still playing&amp;#10;        dp.DPxDisableDoutPixelMode()   # stop driving the MEG trigger lines&amp;#10;        dp.DPxWriteRegCache()          # send those changes to the device&amp;#10;        dp.DPxClose()                  # disconnect&amp;#10;    except Exception:&amp;#10;        pass   # the device was already closed or unplugged: nothing to do&amp;#10;&amp;#10;# atexit.register() asks Python to run closeVpixx when the program ends.&amp;#10;# It runs at a normal finish, after Ctrl-C, and after an error.&amp;#10;# There is deliberately no &quot;End Experiment&quot; code in this experiment: the&amp;#10;# EyeLink plugin ends the program itself (after copying the eye-tracking&amp;#10;# file), before Builder reaches its End Experiment tabs, so code there&amp;#10;# would never run. atexit still does.&amp;#10;atexit.register(closeVpixx)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
