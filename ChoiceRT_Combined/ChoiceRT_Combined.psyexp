    <Routine name="instruct">
      <RoutineSettingsComponent name="instruct" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit" />
        <Param val="" valType="str" updates="None" name="backgroundImg" />
        <Param val="$[0,0,0]" valType="color" updates="None" name="color" />
        <Param val="rgb" valType="str" updates="None" name="colorSpace" />
        <Param val="" valType="str" updates="constant" name="desc" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="" valType="code" updates="None" name="durationEstim" />
        <Param val="False" valType="code" updates="None" name="forceNonSlip" />
        <Param val="instruct" valType="code" updates="None" name="name" />
        <Param val="True" valType="bool" updates="None" name="saveStartStop" />
        <Param val="" valType="code" updates="constant" name="skipIf" />
        <Param val="duration (s)" valType="str" updates="None" name="stopType" />
        <Param val="" valType="code" updates="constant" name="stopVal" />
        <Param val="False" valType="bool" updates="None" name="useWindowParams" />
      </RoutineSettingsComponent>
      <CodeComponent name="vpixx" plugin="None">
        <Param val="# =====================================================================&amp;#10;# VPixx DATAPixx3 (MEG lab): Pixel Mode B triggers + audio scheduler&amp;#10;# ---------------------------------------------------------------------&amp;#10;# TRIGGERS: a 1x1 px patch in the upper-left corner carries the trigger&amp;#10;# value in its BLUE channel (red = green = 0). At each vsync the DATAPixx3&amp;#10;# reads that pixel and puts the value on its digital output -&gt; MEG trigger&amp;#10;# channel. 8 lines available: 1, 2, 4, 8, 16, 32, 64, 128.&amp;#10;# Colours are written literally as (R, G, B) in 0-255 (patch is 'rgb255').&amp;#10;#   TRIG_FIXATION   (0, 0, 1)   fixation cross onset (every trial)&amp;#10;#   TRIG_TONE_L     (0, 0, 2)   tone onset, LEFT ear&amp;#10;#   TRIG_TONE_R     (0, 0, 4)   tone onset, RIGHT ear&amp;#10;#   TRIG_RESET      (0, 0, 0)   black = all trigger lines low&amp;#10;#   spare blue values: 8, 16, 32, 64, 128&amp;#10;# Each onset trigger is held for TRIG_HOLD_FRAMES frames, then the pixel&amp;#10;# goes back to black.&amp;#10;#&amp;#10;# Pixel Mode is switched ON at the start of the first trial (after the&amp;#10;# EyeLink drift check) and OFF on the thanks screen, so EyeLink&amp;#10;# calibration / drift-check graphics never reach the trigger lines.&amp;#10;#&amp;#10;# AUDIO: one tone is written once into DATAPixx3 RAM and replayed every&amp;#10;# trial by the audio scheduler; lrMode 'left' / 'right' sends the (mono)&amp;#10;# buffer to that ear only. Playback is armed just before a flip and pushed&amp;#10;# to the device at that flip's vsync, so tone onset, the tone trigger and&amp;#10;# the start of Builder's response clock all share the same flip.&amp;#10;# =====================================================================&amp;#10;import atexit&amp;#10;import numpy as np&amp;#10;&amp;#10;# ---- trigger codes ----&amp;#10;TRIG_FIXATION = (0, 0, 1)&amp;#10;TRIG_TONE_L = (0, 0, 2)&amp;#10;TRIG_TONE_R = (0, 0, 4)&amp;#10;TRIG_RESET = (0, 0, 0)&amp;#10;TRIG_HOLD_FRAMES = 1   # 1 frame = 8.33 ms at 120 Hz (~10 samples at 1200 Hz)&amp;#10;&amp;#10;# ---- tone ----&amp;#10;TONE_FREQ          = 1000      # Hz&amp;#10;TONE_DURATION      = 0.100     # s&amp;#10;RAMP_DURATION      = 0.010     # s, cosine on/off ramps (no clicks)&amp;#10;AUDIO_SAMPLE_RATE  = 48000     # Hz, DATAPixx3 audio codec&amp;#10;AUDIO_AMPLITUDE    = 0.8       # 0-1, scaled to int16&amp;#10;TONE_BUFFER_ADDR   = int(16e6) # DATAPixx3 RAM address (VPixx default)&amp;#10;VPIXX_AUDIO_VOLUME = 0.5       # codec volume 0-1 (codec opens at 0 = silent!)&amp;#10;&amp;#10;# pypixxlib is imported here; if it is missing the experiment falls back&amp;#10;# to dummy mode (no triggers, PsychoPy sound, *.vp columns empty).&amp;#10;try:&amp;#10;    from pypixxlib import _libdpx as _real_dp&amp;#10;    HAS_PYPIXXLIB = True&amp;#10;except ImportError:&amp;#10;    _real_dp = None&amp;#10;    HAS_PYPIXXLIB = False&amp;#10;&amp;#10;&amp;#10;class _MockDPx:&amp;#10;    &quot;&quot;&quot;No-op stand-in for pypixxlib._libdpx (dummy mode).&quot;&quot;&quot;&amp;#10;    def __getattr__(self, name):&amp;#10;        if name == 'DPxGetTime':&amp;#10;            return lambda: 0.0&amp;#10;        return lambda *a, **k: None&amp;#10;&amp;#10;&amp;#10;def make_tone_int16(freq, dur, rate, ramp, amp):&amp;#10;    n = int(round(dur * rate))&amp;#10;    n_ramp = int(round(ramp * rate))&amp;#10;    t = np.arange(n) / rate&amp;#10;    tone = np.sin(2.0 * np.pi * freq * t)&amp;#10;    up = 0.5 * (1.0 - np.cos(np.pi * np.arange(n_ramp) / n_ramp))&amp;#10;    tone[:n_ramp] *= up&amp;#10;    tone[-n_ramp:] *= up[::-1]&amp;#10;    return (np.clip(tone * amp, -1.0, 1.0) * 32767.0).astype(np.int16)&amp;#10;&amp;#10;&amp;#10;toneWave = make_tone_int16(TONE_FREQ, TONE_DURATION, AUDIO_SAMPLE_RATE,&amp;#10;                           RAMP_DURATION, AUDIO_AMPLITUDE)&amp;#10;toneSamples = int(len(toneWave))&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="# NOTE: Builder runs this tab INSIDE run(), where win, thisExp and expInfo&amp;#10;# live, so the VPixx helpers are defined here rather than Before Experiment.&amp;#10;&amp;#10;# ---- connect to the DATAPixx3 (or fall back to dummy mode) ----&amp;#10;DUMMY_VPIXX = str(expInfo.get('dummy_vpixx', False)).lower() in ('true', '1', 'yes')&amp;#10;if not HAS_PYPIXXLIB and not DUMMY_VPIXX:&amp;#10;    logging.warning('pypixxlib not installed: forcing dummy VPixx mode '&amp;#10;                    '(NO TRIGGERS, PsychoPy sound NOT vsync-locked)')&amp;#10;    DUMMY_VPIXX = True&amp;#10;thisExp.addData('dummy_vpixx', DUMMY_VPIXX)&amp;#10;dp = _MockDPx() if DUMMY_VPIXX else _real_dp&amp;#10;_vpx = {'closed': False, 'frames_left': 0, 'pixel_mode': False, 'vp': {}}&amp;#10;dummySounds = {}&amp;#10;&amp;#10;# Pixel Mode reads the top-left pixel of the whole SCREEN. If the window is&amp;#10;# not full screen (e.g. Builder's Pilot mode forces an 800x600 window), that&amp;#10;# pixel belongs to the desktop and the trigger lines show garbage. Refuse to&amp;#10;# run with real hardware unless the window is full screen in Run mode.&amp;#10;if not DUMMY_VPIXX and (PILOTING or not win.fullscr):&amp;#10;    msg = ('VPixx Pixel Mode triggers need a FULL-SCREEN window in RUN mode '&amp;#10;           '(PILOTING=%s, fullscr=%s). Switch Builder from Pilot to Run, or '&amp;#10;           'tick dummy_vpixx to test without triggers.' % (PILOTING, win.fullscr))&amp;#10;    logging.error(msg)&amp;#10;    raise RuntimeError(msg)&amp;#10;&amp;#10;if DUMMY_VPIXX:&amp;#10;    # Testing without hardware: stereo PsychoPy sounds with the other ear&amp;#10;    # silent. Audible, but timing is not vsync-locked.&amp;#10;    from psychopy import sound as _sound&amp;#10;    _mono = toneWave.astype(np.float32) / 32767.0&amp;#10;    _zero = np.zeros_like(_mono)&amp;#10;    dummySounds['left'] = _sound.Sound(np.column_stack([_mono, _zero]),&amp;#10;                                       sampleRate=AUDIO_SAMPLE_RATE, stereo=True)&amp;#10;    dummySounds['right'] = _sound.Sound(np.column_stack([_zero, _mono]),&amp;#10;                                        sampleRate=AUDIO_SAMPLE_RATE, stereo=True)&amp;#10;else:&amp;#10;    dp.DPxOpen()&amp;#10;    dp.DPxStopAllScheds()&amp;#10;    dp.DPxDisableDoutPixelMode()   # stays OFF through calibration/drift check&amp;#10;    dp.DPxInitAudCodec()&amp;#10;    dp.DPxSetAudLeftVolume(VPIXX_AUDIO_VOLUME)&amp;#10;    dp.DPxSetAudRightVolume(VPIXX_AUDIO_VOLUME)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;    dp.DPxWriteAudioBuffer(toneWave, TONE_BUFFER_ADDR)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;    logging.exp('VPixx audio ready: %d samples @ %d Hz (%.1f ms)'&amp;#10;                % (toneSamples, AUDIO_SAMPLE_RATE,&amp;#10;                   1000.0 * toneSamples / AUDIO_SAMPLE_RATE))&amp;#10;&amp;#10;&amp;#10;# ---------------- Pixel Mode B triggers ----------------&amp;#10;def _set_patch(rgb):&amp;#10;    # rgb is an (R, G, B) tuple in 0-255; the patch is in 'rgb255' space&amp;#10;    trigger_patch.fillColor = rgb&amp;#10;    trigger_patch.lineColor = rgb&amp;#10;&amp;#10;&amp;#10;def reset_trigger():&amp;#10;    # Force the pixel to black.&amp;#10;    _vpx['frames_left'] = 0&amp;#10;    _set_patch(TRIG_RESET)&amp;#10;&amp;#10;&amp;#10;def pixel_mode_on():&amp;#10;    # Call in Begin Routine (before any flip of that routine). No-op if on.&amp;#10;    if _vpx['pixel_mode']:&amp;#10;        return&amp;#10;    reset_trigger()&amp;#10;    dp.DPxEnableDoutPixelModeB()   # blue-channel trigger output&amp;#10;    dp.DPxWriteRegCache()&amp;#10;    _vpx['pixel_mode'] = True&amp;#10;    logging.exp('VPixx Pixel Mode B ON')&amp;#10;&amp;#10;&amp;#10;def pixel_mode_off():&amp;#10;    if not _vpx['pixel_mode']:&amp;#10;        return&amp;#10;    reset_trigger()&amp;#10;    dp.DPxDisableDoutPixelMode()&amp;#10;    dp.DPxWriteRegCache()&amp;#10;    _vpx['pixel_mode'] = False&amp;#10;    logging.exp('VPixx Pixel Mode B OFF')&amp;#10;&amp;#10;&amp;#10;def _stamp_vp(label):&amp;#10;    # Runs right after the flip that carried the trigger: VPixx clock time.&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    dp.DPxUpdateRegCache()&amp;#10;    t = dp.DPxGetTime()&amp;#10;    _vpx['vp'][label] = t&amp;#10;    thisExp.addData(label + '.vp', t)&amp;#10;&amp;#10;&amp;#10;def send_trigger(rgb, label=None):&amp;#10;    # Put `rgb` on the trigger pixel for the NEXT flip, then auto-reset.&amp;#10;    # Call from Each Frame on the frame a stimulus starts&amp;#10;    # (frameNStart == frameN) so the trigger shares the stimulus flip.&amp;#10;    _set_patch(rgb)&amp;#10;    _vpx['frames_left'] = TRIG_HOLD_FRAMES&amp;#10;    if label:&amp;#10;        thisExp.addData(label + '.trigger', rgb[2])   # blue = trigger value&amp;#10;        win.callOnFlip(_stamp_vp, label)&amp;#10;&amp;#10;&amp;#10;def tick_trigger():&amp;#10;    # Call FIRST in Each Frame: resets the pixel to black after the hold.&amp;#10;    if _vpx['frames_left'] &gt; 0:&amp;#10;        _vpx['frames_left'] -= 1&amp;#10;        if _vpx['frames_left'] == 0:&amp;#10;            _set_patch(TRIG_RESET)&amp;#10;&amp;#10;&amp;#10;# ---------------- audio scheduler ----------------&amp;#10;def prep_tone(side):&amp;#10;    &quot;&quot;&quot;Load the schedule for this ear ('left'/'right'). Does NOT start it.&amp;#10;    Call in Begin Routine, well before the tone flip.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    dp.DPxSetAudioSchedule(0.0, AUDIO_SAMPLE_RATE, toneSamples, side,&amp;#10;                           TONE_BUFFER_ADDR)&amp;#10;    dp.DPxWriteRegCache()&amp;#10;&amp;#10;&amp;#10;def arm_tone(side):&amp;#10;    &quot;&quot;&quot;Call on the frame the tone should start, before that frame's flip,&amp;#10;    and AFTER any other VPixx register change on that frame. The start bit&amp;#10;    is pushed to the DATAPixx3 at the flip's vsync. Nothing may call&amp;#10;    DPxUpdateRegCache / DPxWriteRegCache between this and the flip.&quot;&quot;&quot;&amp;#10;    if DUMMY_VPIXX:&amp;#10;        snd = dummySounds[side]&amp;#10;        snd.stop()&amp;#10;        win.callOnFlip(snd.play)&amp;#10;    else:&amp;#10;        dp.DPxStartAudSched()&amp;#10;        dp.DPxWriteRegCacheAfterVideoSync()&amp;#10;&amp;#10;&amp;#10;def close_vpixx():&amp;#10;    # Stop audio, pixel mode off, disconnect (safe to call more than once).&amp;#10;    if _vpx['closed']:&amp;#10;        return&amp;#10;    _vpx['closed'] = True&amp;#10;    if DUMMY_VPIXX:&amp;#10;        return&amp;#10;    for fn in ('DPxStopAllScheds', 'DPxDisableDoutPixelMode',&amp;#10;               'DPxWriteRegCache', 'DPxClose'):&amp;#10;        try:&amp;#10;            getattr(dp, fn)()&amp;#10;        except Exception:&amp;#10;            pass&amp;#10;&amp;#10;&amp;#10;atexit.register(close_vpixx)   # also releases the device if the run aborts&amp;#10;&amp;#10;# ---- 1x1 px trigger patch, exact upper-left screen pixel ----&amp;#10;_ww, _wh = win.size&amp;#10;trigger_patch = visual.Rect(&amp;#10;    win, units='pix', width=1, height=1,&amp;#10;    pos=(-_ww / 2.0 + 0.5, _wh / 2.0 - 0.5),&amp;#10;    lineWidth=0, colorSpace='rgb255',&amp;#10;    fillColor=TRIG_RESET, lineColor=TRIG_RESET,&amp;#10;    interpolate=False, autoLog=False)&amp;#10;trigger_patch.setAutoDraw(True)   # drawn (black) on every flip all session&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="# black trigger pixel, pixel mode off, audio stopped, device closed&amp;#10;reset_trigger()&amp;#10;trigger_patch.setAutoDraw(False)&amp;#10;close_vpixx()&amp;#10;" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="vpixx" valType="code" updates="None" name="name" />
      </CodeComponent>
